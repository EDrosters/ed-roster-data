  .flag.good { color: #1E8F63; background: #EAF6F0; }

  .option-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.22rem; width: 100%; }
  .option-action-btn {
    appearance: none;
    background: #fff;
    border: 1px solid #e4dfee;
    border-radius: 8px;
    padding: 0.28rem 0.42rem;
    font-family: inherit;
    font-size: 0.68rem;
    line-height: 1.2;
    font-weight: 650;
    color: var(--ink-soft);
    cursor: pointer;
    white-space: normal;
    text-align: center;
    min-height: 27px;
    box-shadow: 0 1px 2px rgba(80,70,110,0.04);

function renderBundlePreviewCalendar(container, doctor, role, partner, assignment) {
  const allDays = [];
  assignment.forEach(a => {
    allDays.push(dayNum(a.give.date), dayNum(a.take.dateStr));
  });
  const mondayOfDay = day => {
    const d = new Date(dateFromDayNum(day) + 'T00:00:00Z');
    const offset = (d.getUTCDay() + 6) % 7;
    return day - offset;
  };
  const weekStarts = [...new Set(allDays.map(mondayOfDay))].sort((a,b) => a-b);

  // Build the actual post-swap rosters explicitly:
  // - doctor gives their selected shifts and receives the partner's shifts
  // - partner gives the matched shifts and receives the doctor's selected shifts
  const doctorMap = personShiftMap(doctor, role);
  const partnerMap = personShiftMap(partner, role);
  const postDoctor = { ...doctorMap };
  const postPartner = { ...partnerMap };

  assignment.forEach(a => {
    // Remove the shifts being given away.
    delete postDoctor[a.give.date];
    delete postPartner[a.take.dateStr];

    // Put the exchanged shifts onto their new owners at the swap dates.
    postDoctor[a.take.dateStr] = partnerMap[a.take.dateStr];
    postPartner[a.give.date] = doctorMap[a.give.date];
  });

  function postBundleRaw(name, day) {
    const dateStr = dateFromDayNum(day);
    if (name === doctor) return postDoctor[dateStr] || null;
    if (name === partner) return postPartner[dateStr] || null;
    return rawCodeOn(name, role, dateStr);
  }

  function cellHtml(name, day) {
    const raw = postBundleRaw(name, day);
    const changed = assignment.some(a =>
      (name === doctor && day === dayNum(a.give.date)) ||
      (name === doctor && day === dayNum(a.take.dateStr)) ||
      (name === partner && day === dayNum(a.take.dateStr)) ||
      (name === partner && day === dayNum(a.give.date))
    );
    let cls = 'preview-cal-cell' + (changed ? ' changed' : '');
    let inner;
    if (!raw) {
      inner = '<div class="pc-shift pc-empty"></div>';
    } else {
      const decoded = decodeCode(raw, role);
      if (decoded && decoded.period) {
        const colors = PERIOD_COLOR[decoded.period];
        inner = '<div class="pc-shift" style="background:' + colors.bg + ';color:' + colors.ink + '">' + escapeHtml(PERIOD_NAME[decoded.period]) + '</div>';
      } else {
        cls += ' unavailable';
        inner = '<div class="pc-shift" aria-label="Unavailable">x</div>';
      }
    }
    return '<div class="' + cls + '">' + inner + '</div>';
  }

  function weekBlock(weekStart) {
    const days = Array.from({length:7}, (_,i) => weekStart+i);
    const header = '<div class="preview-cal-row"><div class="preview-cal-label"></div>' + days.map(d => '<div class="preview-cal-cell pc-header"><div class="pc-date">' + pcDateLabel(d) + '</div></div>').join('') + '</div>';
    const row1 = '<div class="preview-cal-row"><div class="preview-cal-label">' + escapeHtml(firstName(doctor)) + '</div>' + days.map(d => cellHtml(doctor,d)).join('') + '</div>';
    const row2 = '<div class="preview-cal-row"><div class="preview-cal-label">' + escapeHtml(firstName(partner)) + '</div>' + days.map(d => cellHtml(partner,d)).join('') + '</div>';
    return header + row1 + row2;
  }

  container.innerHTML = '<div class="preview-card"><div class="day-group-label">Bundle preview: ' + escapeHtml(firstName(doctor)) + ' &harr; ' + escapeHtml(firstName(partner)) + '</div><div class="preview-cal-wrap">' + weekStarts.map(weekBlock).join('<div style="height:0.5rem"></div>') + '</div></div>';
}

function firstName(name) {
  return (name || '').trim().split(/\s+/)[0] || name;
}

const SWAP_BODY_VARIANTS = [
  (result, o) =>
    'Hi ' + firstName(o.partner) + ',\n\n' +
    'I\'d like to propose a shift swap:\n\n' +
    '- I\'ll take your ' + fmtFull(o.date) + ' ' + o.shiftText + ' shift\n' +
    '- You\'ll take my ' + fmtFull(result.giveDateStr) + ' ' + result.giveText + ' shift\n\n' +
    'Let me know!\n\n' +
    'Thanks,\n' + firstName(result.doctor),
  (result, o) =>
    'Hey ' + firstName(o.partner) + '!\n\n' +
    'Hope you\'re doing well. I was wondering if you\'d be up for swapping a shift with me:\n\n' +
    '- I\'d take your ' + fmtFull(o.date) + ' ' + o.shiftText + ' shift\n' +
    '- You\'d take my ' + fmtFull(result.giveDateStr) + ' ' + result.giveText + ' shift\n\n' +
    'Let me know!\n\n' +
    'Thanks so much,\n' + firstName(result.doctor),
  (result, o) =>
    'Hi ' + firstName(o.partner) + ',\n\n' +
    'I hope you are well. I would like to ask whether you would be open to swapping a shift with me:\n\n' +
    '- I would take your ' + fmtFull(o.date) + ' ' + o.shiftText + ' shift\n' +
    '- You would take my ' + fmtFull(result.giveDateStr) + ' ' + result.giveText + ' shift\n\n' +
    'Let me know!\n\n' +
    'Kind regards,\n' + firstName(result.doctor),
  (result, o) =>
    'Hi ' + firstName(o.partner) + ',\n\n' +
    'I hope you are well. Would you be able to do my ' + fmtFull(result.giveDateStr) + ' ' + result.giveText + ' shift, ' +
    'and I can do your ' + fmtFull(o.date) + ' ' + o.shiftText + ' shift?\n\n' +
    'Let me know!\n\n' +
    'Kind regards,\n' + firstName(result.doctor),
];

function buildSwapMailto(result, o) {
  const subject = 'Shift swap request - ' + fmtFull(result.giveDateStr);
  const variant = SWAP_BODY_VARIANTS[Math.floor(Math.random() * SWAP_BODY_VARIANTS.length)];
  const body = variant(result, o);
  return 'mailto:?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
}

function buildTakerMailto(result, t) {
  const subject = 'Shift giveaway request - ' + fmtFull(result.giveDateStr);
  const body =
    'Hi ' + firstName(t.partner) + ',\n\n' +
    'I hope you are well. I am looking to give away my ' + fmtFull(result.giveDateStr) + ' ' + result.giveText + ' shift; ' +
    'no shift would be owed in return. Would you be available and willing to take it?\n\n' +
    'Let me know!\n\n' +
    'Kind regards,\n' + firstName(result.doctor);
  return 'mailto:?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
}

function buildBundleSwapMailto(doctor, role, partnerName, assignment) {
  const lines = assignment.map(a =>
    '- I\'ll take your ' + fmtFull(a.take.dateStr) + ' ' + textOn(partnerName, role, a.take.dateStr) + ' shift, ' +
    'and you\'ll take my ' + fmtFull(a.give.date) + ' ' + textOn(doctor, role, a.give.date) + ' shift'
  ).join('\n');
  const subject = 'Bundle shift swap request - ' + assignment.length + ' shifts';
  const body =
    'Hi ' + firstName(partnerName) + ',\n\n' +
    'I hope you are well. I would like to propose swapping the following shifts as a bundle:\n\n' +
    lines + '\n\n' +
    'Let me know!\n\n' +
    'Kind regards,\n' + firstName(doctor);
  return 'mailto:?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
}

function renderSwapResults(results) {
  const out = document.getElementById('resultsBody');
  const withOptions = results.filter(r => r.options.length > 0);
  if (!withOptions.length) {
    out.innerHTML = '<div class="status-msg">No legal swaps found for any selected shift in this window. Try a wider search window or relax the shift-type restriction.</div>';
    return;
  }

  const flat = [];
  let html = '<div class="day-group-label">Single-shift swap options</div>';

  // Put all single-person/single-shift swap options together at the top.
  const showShiftHeaders = withOptions.length > 1;

  withOptions.forEach(result => {
    if (showShiftHeaders) {
      html += '<div class="day-group-label">Swapping: ' +
        escapeHtml(fmtFull(result.giveDateStr) + ' · ' + result.giveText) +
        '</div>';
    }

    const chronological = result.options.slice().sort((a, b) =>
      a.date.localeCompare(b.date) ||
      b.continuityScore - a.continuityScore ||
      a.partner.localeCompare(b.partner)
    );

    chronological.forEach(o => {
      const idx = flat.length;
      flat.push({ result, option: o });
      const colors = PERIOD_COLOR[o.shiftType];
      const showGoodFit = o.continuityScore > 0 && !o.breaksPartnerNightRun;

      html += '<div class="option-card">' +
        '<span class="type-badge" style="background:' + colors.bg + ';color:' + colors.ink + '">' +
          PERIOD_NAME[o.shiftType] + '</span>' +
        '<div class="option-info">' +
          '<div class="option-action-btn primary person-btn">' +
            escapeHtml(o.partner) +
          '</div>' +
          '<div class="option-action-btn shift-btn">' +
            escapeHtml(fmtFull(o.date) + ' · ' + o.shiftText) +
          '</div>' +
          '<div class="option-meta">' +
            (o.sameDay ? '<span class="flag">same day</span>' : '') +
            (o.breaksPartnerNightRun ? '<span class="flag">mid night-run</span>' : '') +
            (showGoodFit ? '<span class="flag good">good fit</span>' : '') +
          '</div>' +
          '<div class="option-actions">' +
            '<button class="option-action-btn cal-btn" data-idx="' + idx + '">Calendar</button>' +
            '<button class="option-action-btn email-btn" data-idx="' + idx + '">Email</button>' +
          '</div>' +
        '</div>' +
        '<div class="option-preview" id="swapPreview-' + idx + '"></div>' +
      '</div>';
    });
  });

  html += '<div class="status-msg">Single-shift options are shown first. Tap Calendar to preview, or Email to send a request.</div>';
  out.innerHTML = html;

  out.querySelectorAll('.cal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pair = flat[parseInt(btn.dataset.idx, 10)];
      const panel = document.getElementById('swapPreview-' + btn.dataset.idx);
      renderSwapPreviewCalendar(panel, pair.result, pair.option);
    });
  });

  out.querySelectorAll('.email-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pair = flat[parseInt(btn.dataset.idx, 10)];
      window.location.href = buildSwapMailto(pair.result, pair.option);
    });
  });

  // Person/shift buttons are informational and keep the layout fully vertical.
}

// Renders a 2-row (doctor / partner) mini-calendar showing what each
// person's schedule would look like AFTER the swap. Shows the full
// Monday-Sunday week of the give-date; if the take-date falls in a
// different week, a second 2-line week block is added below rather than
// stretching one row wide enough to need horizontal scrolling. Raw codes
// that exist but aren't a workable D/S/E/N shift (leave, "x", CST, etc.)
// are always shown as "x" (unavailable) rather than left blank.
function pcDateLabel(day) {
  const d = new Date(dateFromDayNum(day) + 'T00:00:00Z');
  return d.toLocaleDateString('en-AU', { weekday: 'short', timeZone: 'UTC' }) + ' ' + d.getUTCDate();
}

function renderSwapPreviewCalendar(container, result, o) {
  const role = currentPerson.r;
  const giveDay = dayNum(result.giveDateStr);
  const takeDay = dayNum(o.date);

  function mondayOfDay(day) {
    const d = new Date(dateFromDayNum(day) + 'T00:00:00Z');
    const offset = (d.getUTCDay() + 6) % 7; // Monday-first
    return day - offset;
  }

  const giveWeekStart = mondayOfDay(giveDay);
  const takeWeekStart = mondayOfDay(takeDay);
  const weekStarts = giveWeekStart === takeWeekStart ? [giveWeekStart] : [giveWeekStart, takeWeekStart].sort((a, b) => a - b);

  function postSwapRaw(name, day) {
    if (name === result.doctor) {
      if (day === takeDay) return rawCodeOn(o.partner, role, o.date);
      if (day === giveDay) return null;
    } else if (name === o.partner) {
      if (day === giveDay) return rawCodeOn(result.doctor, role, result.giveDateStr);
      if (day === takeDay) return null;
    }
    return rawCodeOn(name, role, dateFromDayNum(day));
  }

  function cellHtml(name, day) {
    const raw = postSwapRaw(name, day);
    const changed = (day === giveDay || day === takeDay);
    let cls = 'preview-cal-cell' + (changed ? ' changed' : '');
    let inner;
    if (!raw) {
      inner = '<div class="pc-shift pc-empty"></div>';
    } else {
      const decoded = decodeCode(raw, role);
      if (decoded && decoded.period) {
        const colors = PERIOD_COLOR[decoded.period];
        inner = '<div class="pc-shift" style="background:' + colors.bg + ';color:' + colors.ink + '">' + escapeHtml(PERIOD_NAME[decoded.period]) + '</div>';
      } else {
        cls += ' unavailable';
        inner = '<div class="pc-shift" aria-label="Unavailable">x</div>';
      }
    }
    return '<div class="' + cls + '">' + inner + '</div>';
  }

  function weekBlockHtml(weekStart) {
    const days = [];
    for (let i = 0; i < 7; i++) days.push(weekStart + i);
    const headerRow = '<div class="preview-cal-row">' +
      '<div class="preview-cal-label"></div>' +
      days.map((d,i) => '<div class="preview-cal-cell pc-header"><div class="pc-date">' + pcDateLabel(d) + '</div></div>').join('') +
      '</div>';
    const doctorRow = '<div class="preview-cal-row">' +
      '<div class="preview-cal-label">' + escapeHtml(firstName(result.doctor)) + '</div>' +
      days.map(d => cellHtml(result.doctor, d)).join('') +
      '</div>';
    const partnerRow = '<div class="preview-cal-row">' +
      '<div class="preview-cal-label">' + escapeHtml(firstName(o.partner)) + '</div>' +
      days.map(d => cellHtml(o.partner, d)).join('') +
      '</div>';
    return headerRow + doctorRow + partnerRow;
  }

  const weekBlocks = weekStarts.map(weekBlockHtml).join('<div style="height:0.5rem;"></div>');

  container.innerHTML =
    '<div class="preview-card">' +
    '<div class="day-group-label">Preview: ' + escapeHtml(firstName(result.doctor)) + ' &harr; ' + escapeHtml(firstName(o.partner)) + '</div>' +
    '<div class="preview-cal-wrap">' + weekBlocks + '</div>' +
    '</div>';
}

function renderTakerTab() {
  const body = document.getElementById('tabBody');
  body.innerHTML = '<div id="takerBody"><div class="status-msg">Checking who could take these…</div></div>';
  try {
    const dates = selectedShiftDates();
    const results = dates.map(d => findTakers(currentPerson.n, currentPerson.r, d));
    const bundleTakers = dates.length > 1 ? findBundleTakers(currentPerson.n, currentPerson.r, dates) : [];
    renderTakerResults(results, bundleTakers);
  } catch (err) {
    document.getElementById('takerBody').innerHTML = '<div class="status-msg">' + escapeHtml(err.message) + '</div>';
  }
}

function buildBundleTakerMailto(doctor, dates) {
  const shiftLines = dates.map(d => '- ' + fmtFull(d) + ' ' + textOn(doctor.n, doctor.r, d) + ' shift').join('\n');
  const subject = 'Shift giveaway request - ' + dates.length + ' shifts';
  const body =
    'Hi {name},\n\n' +
    'I hope you are well. I am looking to give away the following shifts as a bundle; no shift would be owed in return:\n\n' +
    shiftLines + '\n\n' +
    'Would you be available and willing to take all of these?\n\n' +
    'Let me know!\n\n' +
    'Kind regards,\n' + firstName(doctor.n);
  return { subject, body };
}

function renderTakerResults(results, bundleTakers) {
  const out = document.getElementById('takerBody');
  const withTakers = results.filter(r => r.takers.length > 0);
  bundleTakers = bundleTakers || [];

  let html = '';
  if (bundleTakers.length) {
    const dates = selectedShiftDates();
    html += '<div class="day-group-label">Bundle - take all ' + dates.length + ' shifts</div>';
    bundleTakers.forEach((name, idx) => {
      html += '<div class="taker-chip bundle-chip" data-bundle-idx="' + idx + '"><div class="name">' + escapeHtml(name) + '</div>' +
        '<div class="meta">Free and legal for every selected shift</div></div>';
    });
  }

  if (!withTakers.length && !bundleTakers.length) {
    out.innerHTML = '<div class="status-msg">No one is free and legally able to take any of these shifts outright.</div>';
    return;
  }

  const flat = []; // { result, taker }
  withTakers.forEach(result => {
    html += '<div class="day-group-label">For ' + escapeHtml(fmtFull(result.giveDateStr)) + ' &middot; ' + escapeHtml(result.giveText) + '</div>';
    result.takers.forEach(t => {
      const idx = flat.length;
      flat.push({ result, taker: t });
      const showGoodFit = t.continuityScore > 0 && !t.breaksNightRun;
      html += '<div class="taker-chip" data-idx="' + idx + '"><div class="name">' + escapeHtml(t.partner) + '</div>' +
        '<div class="meta">Free that day' + (t.breaksNightRun ? ' &middot; would sit mid a night run' : '') +
        (showGoodFit ? '<span class="flag good">good fit</span>' : '') +
        '</div></div>';
    });
  });
  html += '<div class="status-msg">Tap a name to email a request.</div>';
  out.innerHTML = html;

  out.querySelectorAll('.taker-chip[data-idx]').forEach(chip => {
    const pair = flat[parseInt(chip.dataset.idx, 10)];
    chip.addEventListener('click', () => { window.location.href = buildTakerMailto(pair.result, pair.taker); });
  });

  out.querySelectorAll('.bundle-chip').forEach(chip => {
    const name = bundleTakers[parseInt(chip.dataset.bundleIdx, 10)];
    chip.addEventListener('click', () => {
      const { subject, body } = buildBundleTakerMailto(currentPerson, selectedShiftDates());
      window.location.href = 'mailto:?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body.replace('{name}', firstName(name)));
    });
  });
}


// ---------------------------------------------------------------------
// Load roster
// ---------------------------------------------------------------------
async function loadRoster() {
  try {
    const res = await fetch(DATA_URL, { cache: 'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    PEOPLE = (await res.json()).filter(p => !NON_PERSON_NAMES.has(p.n));

    const prevValue = currentPerson ? currentPerson.n + '|' + currentPerson.r : '';

    const consultants = PEOPLE.filter(p => p.r === 'C').sort((a, b) => a.n.localeCompare(b.n));
    const registrarsList = PEOPLE.filter(p => p.r === 'R').sort((a, b) => a.n.localeCompare(b.n));

    consultantSelect.innerHTML = '<option value="">Choose consultant...</option>' +
      consultants.map(p => '<option value="' + escapeHtml(p.n) + '">' + escapeHtml(p.n) + '</option>').join('');
    registrarSelect.innerHTML = '<option value="">Choose registrar...</option>' +
      registrarsList.map(p => '<option value="' + escapeHtml(p.n) + '">' + escapeHtml(p.n) + '</option>').join('');

    if (prevValue) {
      const [name, role] = prevValue.split('|');
      if (role === 'C' && consultants.some(p => p.n === name)) { consultantSelect.value = name; currentPerson = { n: name, r: 'C' }; }
      else if (role === 'R' && registrarsList.some(p => p.n === name)) { registrarSelect.value = name; currentPerson = { n: name, r: 'R' }; }
    }

    if (selectedShifts.size) renderDetail(); else renderShiftList();
  } catch (err) {
    console.error('Roster load error:', err);
    content.innerHTML = '<div class="empty-state">Couldn\'t load the roster right now. Try again shortly.</div>';
  }
}

loadRoster();
setInterval(loadRoster, 5 * 60 * 1000);
</script>

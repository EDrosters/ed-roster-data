  .preview-cal-cell.pc-header { background: transparent; border: none; min-height: auto; }
  .preview-cal-cell.changed { outline: 2px solid var(--accent); }
  .preview-cal-cell.unavailable .pc-shift { background: #ECEDF6; color: var(--ink-faint); }
  .pc-date { font-size: 0.58rem; font-weight: 700; color: var(--ink-soft); }
  .pc-shift { margin-top: 2px; font-size: 0.56rem; font-weight: 700; border-radius: 4px; padding: 1px 1px; }
  .pc-shift.pc-empty { color: var(--ink-faint); background: none; }

  .taker-chip { background: #fff; border-radius: 10px; padding: 0.7rem 0.9rem; margin-bottom: 0.5rem; box-shadow: 0 1px 2px rgba(20,20,40,0.04); cursor: pointer; }
  .taker-chip:active { background: #f3f4f8; }
  .taker-chip .name { font-weight: 700; font-size: 0.92rem; }
  .taker-chip .meta { font-size: 0.76rem; color: var(--ink-faint); margin-top: 0.1rem; }

  .actions-row { margin-top: 0.6rem; margin-bottom: 1.5rem; }
  .ghost-btn {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.9rem;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }

  .site-link { text-align: center; padding: 0.5rem 1rem 1.5rem; }
  .site-link a { color: var(--ink-faint); font-size: 0.8rem; text-decoration: none; }

  .status-msg { font-size: 0.85rem; color: var(--ink-faint); text-align: center; padding: 0.6rem 0; }
  .bundle-chip { outline: 2px solid var(--accent); }
  .search-btn.bundle-btn {
    background: #fff;
    color: var(--accent);
    border: 2px solid var(--accent);
  }
  .option-card.bundle-match { cursor: pointer; }
  @media (max-width: 900px) {
    .option-card { grid-template-columns: 46px minmax(0, 1fr); }
    .option-preview { grid-column: 1 / -1; }

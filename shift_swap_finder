  }
  .shift-card:active { background: #f3f4f8; }
  .chevron { color: var(--ink-faint); font-size: 1.3rem; flex-shrink: 0; margin-left: auto; }
  .date-block { min-width: 48px; text-align: center; flex-shrink: 0; }
  .date-block .dow { font-size: 0.68rem; color: var(--ink-faint); text-transform: uppercase; font-weight: 600; letter-spacing: 0.03em; }
  .date-block .num { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; line-height: 1.1; }
  .date-block .mon { font-size: 0.68rem; color: var(--ink-faint); font-weight: 600; }
  .shift-info { flex: 1; min-width: 0; }
  .shift-text { font-weight: 700; font-size: 0.95rem; }
  .shift-sub { font-size: 0.78rem; color: var(--ink-faint); margin-top: 0.15rem; }

  .detail-back {
    display: inline-flex;

  .day-group-label:first-child { margin-top: 0; }

  .cal-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .cal-legend { display: flex; gap: 0.9rem; flex-wrap: wrap; margin: 0 0 0.8rem 0.1rem; }
  .mode-row { margin: 0 0 0.8rem; }
  .mode-toggle-btn {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 0.4rem 0.9rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .mode-toggle-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .cal-legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-soft); }

  .cal-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; margin-bottom: 0.8rem; }
  .cal-nav { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 1rem; border-bottom: 1px solid var(--line); }
  .cal-nav button {
    width: 30px; height: 30px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .cal-nav button:active { background: var(--canvas); }
  .cal-month-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.05rem; color: var(--ink); }
  .cal-weekday-row { display: grid; grid-template-columns: repeat(7, 1fr); border-bottom: 1px solid var(--line); }
  .cal-weekday-row div { text-align: center; padding: 0.55rem 0; font-size: 0.62rem; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.03em; }
  .cal-body { display: grid; grid-template-columns: repeat(7, 1fr); }
  .cal-daycell {
    min-height: 78px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0.4rem 0.35rem;
  }
  .cal-daycell.off-month { background: #fafafb; }
  .cal-daynum { display: inline-block; font-size: 0.72rem; font-weight: 600; color: var(--ink-soft); }
  .cal-daynum.today {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--ink); color: #fff; font-weight: 700;
  }
  .cal-shift-box {
    margin-top: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.4rem;
    border-radius: 7px;
    line-height: 1.25;
    cursor: pointer;
  }
  .cal-shift-box.not-clickable { cursor: default; }
  .cal-shift-box.selected { outline: 2px solid var(--accent); outline-offset: 1px; }
  .cal-check { margin-right: 0.2rem; }

  .select-bar {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--line);

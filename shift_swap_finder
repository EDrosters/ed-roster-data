const consultantSelect = document.getElementById('consultantSelect');
const registrarSelect = document.getElementById('registrarSelect');
const content = document.getElementById('content');

function selectPerson(name, role) {
  selectedShifts = new Set();
  currentPerson = name ? { n: name, r: role } : null;
  renderShiftList();
}

consultantSelect.addEventListener('change', () => {
  if (consultantSelect.value) { registrarSelect.value = ''; selectPerson(consultantSelect.value, 'C'); }
  else selectPerson('', null);
});
registrarSelect.addEventListener('change', () => {
  if (registrarSelect.value) { consultantSelect.value = ''; selectPerson(registrarSelect.value, 'R'); }
  else selectPerson('', null);
});

let viewYear = null;
let viewMonthIdx = null; // 0-based

function pad2(n) { return n < 10 ? '0' + n : '' + n; }

function fmtMonthTitle(year, monthIdx) {
  return new Date(Date.UTC(year, monthIdx, 1)).toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}

function renderShiftList() {
  if (!currentPerson) {
    content.innerHTML = '<div class="empty-state">Pick your name above to see your upcoming shifts.</div>';
    return;
  }
  if (viewYear === null) {
    const t = new Date(todayStr + 'T00:00:00Z');
    viewYear = t.getUTCFullYear();
    viewMonthIdx = t.getUTCMonth();
  }

  const map = personShiftMap(currentPerson.n, currentPerson.r);
  const firstOfMonth = new Date(Date.UTC(viewYear, viewMonthIdx, 1));
  const daysInMo = new Date(Date.UTC(viewYear, viewMonthIdx + 1, 0)).getUTCDate();
  const leadOffset = (firstOfMonth.getUTCDay() + 6) % 7; // Monday-first

  let html = '<div class="cal-legend">' + Object.keys(PERIOD_NAME).map(t =>
    '<span class="cal-legend-item"><span class="cal-dot" style="background:' + PERIOD_COLOR[t].ink + '"></span>' + PERIOD_NAME[t] + '</span>').join('') + '</div>';

  html += '<div class="mode-row"><button id="multiModeBtn" class="mode-toggle-btn' + (multiSelectMode ? ' active' : '') + '">Multi-shift swap</button></div>';

  html += '<div class="cal-card">' +
    '<div class="cal-nav"><button id="calPrev">&lsaquo;</button>' +
    '<div class="cal-month-title">' + fmtMonthTitle(viewYear, viewMonthIdx) + '</div>' +
    '<button id="calNext">&rsaquo;</button></div>';

  const wdNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  html += '<div class="cal-weekday-row">' + wdNames.map(w => '<div>' + w + '</div>').join('') + '</div>';

  html += '<div class="cal-body">';
  for (let i = 0; i < leadOffset; i++) html += '<div class="cal-daycell off-month"></div>';

  for (let day = 1; day <= daysInMo; day++) {
    const dStr = viewYear + '-' + pad2(viewMonthIdx + 1) + '-' + pad2(day);
    const raw = map[dStr];
    const decoded = raw ? decodeCode(raw, currentPerson.r) : null;
    const isToday = dStr === todayStr;
    const clickable = !!(decoded && decoded.period) && dStr >= todayStr;
    const isSelected = selectedShifts.has(dStr);

    html += '<div class="cal-daycell" data-date="' + dStr + '">' +
      '<div class="cal-daynum' + (isToday ? ' today' : '') + '">' + day + '</div>';
    if (decoded && decoded.period) {
      const colors = PERIOD_COLOR[decoded.period];
      html += '<div class="cal-shift-box' + (clickable ? '' : ' not-clickable') + (isSelected ? ' selected' : '') +
        '" style="background:' + colors.bg + ';color:' + colors.ink + '"' + (clickable ? ' data-clickable="1"' : '') + '>' +
        (isSelected ? '<span class="cal-check">&#10003;</span>' : '') + escapeHtml(decoded.text) + '</div>';
    } else if (decoded) {
      html += '<div class="cal-shift-box not-clickable" style="background:#ECEDF6;color:var(--ink)">' + escapeHtml(decoded.text) + '</div>';
    }
    html += '</div>';
  }
  const totalCells = leadOffset + daysInMo;
  const trailing = (7 - (totalCells % 7)) % 7;
  for (let i = 0; i < trailing; i++) html += '<div class="cal-daycell off-month"></div>';
  html += '</div></div>';

  const n = selectedShifts.size;
  html += '<div class="status-msg">' + (multiSelectMode
    ? 'Tap one or more upcoming shifts (in any order), then continue.'
    : 'Tap an upcoming shift to find a swap or give it away.') + '</div>';
  if (multiSelectMode && n > 0) {
    html += '<div class="select-bar">' +
      '<span>' + n + ' shift' + (n > 1 ? 's' : '') + ' selected</span>' +
      '<div class="select-bar-actions"><button class="ghost-btn" id="clearSelBtn">Clear</button>' +
      '<button class="search-btn" id="continueBtn" style="margin:0;width:auto;padding:0.6rem 1rem;">Continue</button></div></div>';
  }
  content.innerHTML = html;

  document.getElementById('multiModeBtn').addEventListener('click', () => {
    multiSelectMode = !multiSelectMode;
    selectedShifts = new Set();
    renderShiftList();
  });

  content.querySelectorAll('.cal-shift-box[data-clickable="1"]').forEach(box => {
    box.addEventListener('click', () => {
      const cell = box.closest('.cal-daycell');
      const d = cell.dataset.date;
      if (multiSelectMode) {
        if (selectedShifts.has(d)) selectedShifts.delete(d);
        else selectedShifts.add(d);
        renderShiftList();
      } else {
        selectedShifts = new Set([d]);
        activeTab = 'swap';
        acceptTypeSet = new Set();
        acceptDaySet = new Set();
        renderDetail();
      }
    });
  });

  const continueBtn = document.getElementById('continueBtn');
  if (continueBtn) {
    continueBtn.addEventListener('click', () => {
      activeTab = 'swap';
      acceptTypeSet = new Set();
      acceptDaySet = new Set();
      renderDetail();
    });
  }
  const clearSelBtn = document.getElementById('clearSelBtn');
  if (clearSelBtn) {
    clearSelBtn.addEventListener('click', () => {
      selectedShifts = new Set();
      renderShiftList();
    });
  }

  document.getElementById('calPrev').addEventListener('click', () => {
    viewMonthIdx--;
    if (viewMonthIdx < 0) { viewMonthIdx = 11; viewYear--; }
    renderShiftList();
  });
  document.getElementById('calNext').addEventListener('click', () => {
    viewMonthIdx++;
    if (viewMonthIdx > 11) { viewMonthIdx = 0; viewYear++; }
    renderShiftList();
  });
}

function selectedShiftDates() {
  return Array.from(selectedShifts).sort();
}

function renderDetail() {
  const dates = selectedShiftDates();
  if (!dates.length) { renderShiftList(); return; }

  let html = '<button class="detail-back" id="backBtn">&larr; Your shifts</button>';
  html += '<div class="summary-card"><div class="label">Looking to move (' + dates.length + ')</div>';
  dates.forEach(d => {
    const decoded = decodeCode(personShiftMap(currentPerson.n, currentPerson.r)[d], currentPerson.r);
    const colors = PERIOD_COLOR[decoded.period];
    html += '<div class="main" style="color:' + colors.ink + '">' + escapeHtml(fmtFull(d)) + ' &middot; ' + escapeHtml(decoded.text) + '</div>';
  });
  html += '</div>';

  html += '<div class="tabs">' +
    '<button class="tab-btn' + (activeTab === 'swap' ? ' active' : '') + '" data-tab="swap">Find a swap</button>' +
    '<button class="tab-btn' + (activeTab === 'taker' ? ' active' : '') + '" data-tab="taker">Give it away</button>' +
    '</div>';

  html += '<div id="tabBody"></div>';
  content.innerHTML = html;

  document.getElementById('backBtn').addEventListener('click', () => { selectedShifts = new Set(); renderShiftList(); });
  content.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => { activeTab = btn.dataset.tab; renderDetail(); });
  });

  if (activeTab === 'swap') renderSwapTab();
  else renderTakerTab();
}

function renderSwapTab() {
  const body = document.getElementById('tabBody');
  const dates = selectedShiftDates();
  const giveTypes = new Set(dates.map(d => periodOn(currentPerson.n, currentPerson.r, d)));
  const giveType = giveTypes.size === 1 ? Array.from(giveTypes)[0] : null; // only auto-fill "same type" when every selected shift shares one type
  const dayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  body.innerHTML =
    '<div class="controls">' +
      '<div class="field"><label>Search window</label>' +
        '<select id="windowSelect"><option value="7">1 week either side</option><option value="14" selected>2 weeks either side</option><option value="28">4 weeks either side</option></select>' +
      '</div>' +
      '<div class="field"><label>Accept swaps of these shifts only</label>' +
        '<div class="type-toggles">' +
          '<div class="type-toggle" data-type="d">D</div><div class="type-toggle" data-type="s">S</div>' +
          '<div class="type-toggle" data-type="e">E</div><div class="type-toggle" data-type="n">N</div>' +
        '</div>' +
      '</div>' +
      '<div class="field"><label>Accept swaps on these days only</label>' +
        '<div class="day-toggles">' + dayLabels.map((d, i) => '<div class="day-toggle" data-day="' + i + '">' + d + '</div>').join('') + '</div>' +
      '</div>' +
      '<label class="checkrow"><input type="checkbox" id="sameTypeOnly"> Only offer the same shift type back</label>' +
      '<label class="checkrow"><input type="checkbox" id="allowSameDay" checked> Allow a same-day, different-type swap</label>' +
    '</div>' +
    '<button class="search-btn" id="searchBtn">Search</button>' +
    (dates.length > 1 ? '<button class="search-btn bundle-btn" id="bundleBtn">Bundle swap options</button>' : '') +
    '<div id="resultsBody"></div>' +
    '<div id="bundleResults"></div>';

  function refreshToggleStyles() {
    body.querySelectorAll('.type-toggle').forEach(el => el.classList.toggle('on', acceptTypeSet.has(el.dataset.type)));
    body.querySelectorAll('.day-toggle').forEach(el => el.classList.toggle('on', acceptDaySet.has(parseInt(el.dataset.day, 10))));
  }
  refreshToggleStyles();

  body.querySelectorAll('.type-toggle').forEach(el => {
    el.addEventListener('click', () => {
      const t = el.dataset.type;
      if (acceptTypeSet.has(t)) acceptTypeSet.delete(t);
      else acceptTypeSet.add(t);
      refreshToggleStyles();
    });
  });

  body.querySelectorAll('.day-toggle').forEach(el => {
    el.addEventListener('click', () => {
      const d = parseInt(el.dataset.day, 10);
      if (acceptDaySet.has(d)) acceptDaySet.delete(d);
      else acceptDaySet.add(d);
      refreshToggleStyles();
    });
  });

  document.getElementById('sameTypeOnly').addEventListener('change', (e) => {
    acceptTypeSet.clear();
    if (e.target.checked && giveType) acceptTypeSet.add(giveType);
    refreshToggleStyles();
  });

  document.getElementById('searchBtn').addEventListener('click', () => {
    const windowDays = parseInt(document.getElementById('windowSelect').value, 10);
    const sameTypeOnly = document.getElementById('sameTypeOnly').checked;
    const allowSameDay = document.getElementById('allowSameDay').checked;
    const resultsBody = document.getElementById('resultsBody');
    try {
      const results = dates.map(d => findSwaps(currentPerson.n, currentPerson.r, d, windowDays, sameTypeOnly, acceptTypeSet, acceptDaySet, allowSameDay));
      renderSwapResults(results);
    } catch (err) {
      resultsBody.innerHTML = '<div class="status-msg">' + escapeHtml(err.message) + '</div>';
    }
  });

  const bundleBtn = document.getElementById('bundleBtn');
  if (bundleBtn) {
    bundleBtn.addEventListener('click', () => {
      const windowDays = parseInt(document.getElementById('windowSelect').value, 10);
      const sameTypeOnly = document.getElementById('sameTypeOnly').checked;
      const allowSameDay = document.getElementById('allowSameDay').checked;
      const bundleResultsEl = document.getElementById('bundleResults');
      bundleResultsEl.innerHTML = '<div class="status-msg">Searching for full bundle swaps…</div>';
      setTimeout(() => {
        try {
          const matches = findBundleSwapPartners(currentPerson.n, currentPerson.r, dates, {
            windowDays, sameTypeOnly, acceptTypes: acceptTypeSet, acceptDays: acceptDaySet, allowSameDay,
          });
          renderBundleSwapResults(bundleResultsEl, matches);
          // Jump straight to the beginning of the bundle results.
          const start = document.getElementById('bundleResultsStart');
          if (start) start.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (err) {
          bundleResultsEl.innerHTML = '<div class="status-msg">' + escapeHtml(err.message) + '</div>';
          const start = document.getElementById('bundleResultsStart');
          if (start) start.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 20);
    });
  }
}


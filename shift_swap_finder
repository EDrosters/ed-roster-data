  .option-card {
    background: #fff;
    border: 1px solid #eeeaf4;
    border-radius: 12px;
    padding: 0.55rem 0.65rem;
    margin-bottom: 0.45rem;
    box-shadow: 0 1px 3px rgba(80,70,110,0.05);
    display: grid;
    grid-template-columns: 52px minmax(190px, 0.9fr) minmax(300px, 1.45fr);

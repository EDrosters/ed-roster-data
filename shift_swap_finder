  }
  .summary-card .label { font-size: 0.72rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.03em; font-weight: 600; }
  .summary-card .main { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.05rem; margin-top: 0.2rem; }

  .tabs { display: flex; gap: 0.4rem; margin-bottom: 1rem; }
  .tab-btn {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;

  .type-badge { font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.38rem; border-radius: 999px; display: inline-block; align-self: flex-start; }
  .option-info { display: flex; flex-direction: column; gap: 0.22rem; min-width: 0; }
  .option-partner { font-weight: 700; font-size: 0.92rem; }
  .option-meta { font-size: 0.76rem; color: var(--ink-faint); margin-top: 0.1rem; }

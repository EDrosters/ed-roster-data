  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; height: 100%; }
  body {
    background: var(--canvas);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

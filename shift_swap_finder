  .content { padding: 1rem; max-width: 760px; margin: 0 auto; }

  .empty-state {
    text-align: center;
    color: var(--ink-faint);
    padding: 3rem 1rem;
    font-size: 0.95rem;
  }

  .day-group-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);

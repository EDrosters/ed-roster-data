  .cal-wrap { margin-bottom: 0.6rem; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .cal-headrow { margin-bottom: 3px; }
  .cal-head-cell { font-size: 0.62rem; font-weight: 700; color: var(--ink-faint); text-align: center; text-transform: uppercase; }
  .cal-cell {
    background: #fff;

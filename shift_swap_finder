<body>
<header>
  <h1>Find a Swap</h1>
  <div class="person-row">
    <select class="person-select" id="consultantSelect">
      <option value="">Choose consultant...</option>
    </select>
    <select class="person-select" id="registrarSelect">
      <option value="">Choose registrar...</option>
    </select>
  </div>
</header>

<div class="content" id="content">
  <div class="empty-state">Pick your name above to see your upcoming shifts.</div>
</div>

<div class="site-link"><a href="https://edrosters.com" target="_blank" rel="noopener">edrosters.com</a></div>

<script>
const DATA_URL = "https://edrosters.github.io/ed-roster-data/my_roster.json";
let PEOPLE = [];
let currentPerson = null;   // { n, r }
let selectedShifts = new Set(); // dates picked for swap/giveaway — sequential or not
let multiSelectMode = false;
let activeTab = 'swap';
let acceptTypeSet = new Set(); // "accept swaps of these shifts only" — empty = accept any type
let acceptDaySet = new Set(); // "accept swaps on these days only" (0=Mon..6=Sun) — empty = accept any day
const todayStr = new Date().toISOString().slice(0, 10);

// ---------------------------------------------------------------------
// Roster decoding — ported directly from myshifts.html so this page
// reads shift codes exactly the same way as the roster app does.
// ---------------------------------------------------------------------
const DAY_ROLE = {1:'EPIC',2:'Purple',3:'Green',4:'Fast Track',5:'SSU',6:'Purple',7:'Green',9:'Green'};
const EVENING_ROLE = {1:'EPIC',2:'Purple',3:'Green',4:'Fast Track',5:'SSU',6:'Green',7:'Purple',9:'Green'};
const WED_ROLE = {x:'Wednesday Purple', y:'Wednesday Fast Track', z:'Wednesday OM'};
const PERIOD_NAME = {d:'Day', s:'Swing', e:'Eve', n:'Night'};
const REG_ROLE = {
  d: {'1':'Purple','2':'Green','3':'Fast Track','4':'SSU','5':'Purple'},
  s: {'1':'Green','2':'Purple','3':'Green','4':'Green','5':'Purple','6':'Purple'},
  e: {'1':'Purple','2':'Green','3':'Fast Track','4':'Green','5':'Purple','6':'Fast Track','7':'Purple','8':'Green','9':'Purple','z':'Green','01':'Purple','02':'Green'},
  n: {'1':'ERIC','2':'Purple','3':'Green','4':'SSU','5':'Fast Track','6':'Purple'},
};
const PERIOD_COLOR = {
  d: {bg:'#FBF6D9', ink:'#A6942A'},
  s: {bg:'#EAF6F0', ink:'#1E8F63'},
  e: {bg:'#E3F2FB', ink:'#3B7EA8'},
  n: {bg:'#F7E3DC', ink:'#A4462E'},
};

// ---------------------------------------------------------------------
// ERIC-capable registrars — mirrors column C of the roster spreadsheet.
// This isn't in the live JSON feed, so it's maintained here by hand.
// Update this list whenever it changes during the term (names must
// match the roster exactly, including the "(TS3)"/"(u)" etc. suffix).
// ---------------------------------------------------------------------
const ERIC_CAPABLE_REGS = [
  // "Joyce Chan (TS1)",
  // "Alfred Liu (PEM)",
];
function isEricCapable(name) { return ERIC_CAPABLE_REGS.includes(name); }

// ---------------------------------------------------------------------
// Non-person rows the roster feed lists under the "C" (consultant) role
// for reference/summary purposes only — not real people, so they must
// never appear in the name dropdowns or be treated as swap partners.
// ---------------------------------------------------------------------
const NON_PERSON_NAMES = new Set([
  'Director on call',
  'FACEM Total',
  'JMOs minimum',
  'JMOs rostered',
  'Registrars',
  'funded',
]);

function decodeCode(raw, role) {
  if (!raw) return null;
  let lower = raw.toLowerCase();
  let hasTraining = false;
  if (lower.endsWith('-t')) { hasTraining = true; lower = lower.slice(0, -2); }
  const withTraining = (result) => {
    if (result && hasTraining) result.text += ' + Teaching';
    return result;
  };
  if (lower === 'x' || lower === 'l' || lower === 'cl' || lower === 'sl' || lower === 'bl' || lower === 'el' || lower.startsWith('pl')) return null;
  if (lower === '8') return withTraining({ text: 'CST', period: null });
  if (lower === 'rt') return { text: 'Teaching', period: null };
  if (PERIOD_NAME[lower]) return withTraining({ text: PERIOD_NAME[lower], period: lower });

  let m = lower.match(/^d([xyz])$/);
  if (m) return withTraining({ text: WED_ROLE[m[1]], period: 'd' });

  m = lower.match(/^([dsen])(0?[0-9]{1,2}|z)([ac])?$/);
  if (m) {
    const period = m[1], num = m[2], suffix = m[3];
    const onCall = suffix === 'c';
    let text;
    if (role === 'C' && period === 'd' && DAY_ROLE[num]) text = 'Day - ' + DAY_ROLE[num];
    else if (role === 'C' && period === 'e' && EVENING_ROLE[num]) text = 'Eve - ' + EVENING_ROLE[num];
    else if (role === 'R' && REG_ROLE[period] && REG_ROLE[period][num]) text = PERIOD_NAME[period] + ' - ' + REG_ROLE[period][num];
    else text = PERIOD_NAME[period] + ' ' + num;
    if (onCall) text += ' (On call)';
    return withTraining({ text, period });
  }
  return { text: raw, period: null };
}

function personShiftMap(name, role) {
  const rec = PEOPLE.find(p => p.n === name && p.r === role);
  const map = {};
  if (!rec) return map;
  const dates = rec.d.split('|');
  const codes = rec.v.split('|');
  dates.forEach((d, i) => { map[d] = codes[i]; });
  return map;
}

function fmtFull(dateStr) { return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' }); }
function mondayOf(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const offset = (d.getDay() + 6) % 7;
  d.setDate(d.getDate() - offset);
  return d;
}
function fmtWeekRange(mondayDate) {
  const sunday = new Date(mondayDate);
  sunday.setDate(sunday.getDate() + 6);
  const sameMonth = mondayDate.getMonth() === sunday.getMonth();
  const startStr = mondayDate.toLocaleDateString('en-AU', { day: 'numeric', month: sameMonth ? undefined : 'short' });
  const endStr = sunday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
  return startStr + ' - ' + endStr;
}
function fmtGroupLabel(dateStr) {
  const thisMonday = mondayOf(todayStr);
  const cardMonday = mondayOf(dateStr);
  const weekDiff = Math.round((cardMonday - thisMonday) / (7 * 86400000));
  if (weekDiff === 0) return 'This Week';
  if (weekDiff === 1) return 'Next Week';
  return fmtWeekRange(cardMonday);
}
function escapeHtml(s) {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

// ---------------------------------------------------------------------
// EBA rest-rule engine — same rules as ed_swap_finder.py, keyed by
// calendar day number instead of a spreadsheet row index.
// ---------------------------------------------------------------------
const SHIFT_TIMES = { d:{start:8.0,end:17.5}, s:{start:11.0,end:20.5}, e:{start:14.5,end:24.0}, n:{start:23.0,end:32.5} };
const REST_DAY_SWING_EVE = 10.0, REST_SINGLE_NIGHT = 23.0, REST_MULTI_NIGHT = 48.0, REST_WITHIN_NIGHT_RUN = 10.0;
const RADIUS = 5, EPS = 1e-9;

function dayNum(dateStr) { return Math.round(Date.parse(dateStr + 'T00:00:00Z') / 86400000); }
function dateFromDayNum(n) { return new Date(n * 86400000).toISOString().slice(0, 10); }

// Consultant evening slot e1/e1a/e1c runs 15:30–01:00 instead of the
// standard 14:30–00:00 evening window — everything else uses SHIFT_TIMES.
function shiftTimesFor(code, role) {
  if (!code) return null;
  const raw = String(code).trim();
  let lower = raw.toLowerCase();
  if (lower.endsWith('-t')) lower = lower.slice(0, -2);
  const decoded = decodeCode(raw, role);
  if (!decoded || !decoded.period) return null;
  if (decoded.period === 'e' && role === 'C' && /^e1[ac]?$/.test(lower)) return { start: 15.5, end: 25.0 };
  return SHIFT_TIMES[decoded.period];
}

function rawCodeOn(name, role, dateStr) {
  const map = personShiftMap(name, role);
  return map[dateStr] || null;
}
function periodOn(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  if (!raw) return null;
  const decoded = decodeCode(raw, role);
  return decoded ? decoded.period : null;
}
function isFreeOn(name, role, dateStr) {
  return !rawCodeOn(name, role, dateStr);
}
function textOn(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  const decoded = decodeCode(raw, role);
  return decoded ? decoded.text : raw;
}

// Map of day -> { period, start, end } for every workable D/S/E/N shift a person holds.
function personDayInfo(name, role) {
  const map = personShiftMap(name, role);
  const out = new Map();
  Object.keys(map).forEach(dateStr => {
    const raw = map[dateStr];
    if (!raw) return;
    const decoded = decodeCode(raw, role);
    if (!decoded || !decoded.period) return;
    const times = shiftTimesFor(raw, role);
    out.set(dayNum(dateStr), { period: decoded.period, start: times.start, end: times.end });
  });
  return out;
}

function restRequiredAfter(dayInfo, day) {
  const info = dayInfo.get(day);
  if (!info) return 0.0;
  if (info.period !== 'n') return REST_DAY_SWING_EVE;
  if ((dayInfo.get(day + 1) || {}).period === 'n') return REST_WITHIN_NIGHT_RUN;
  let run = 1;
  while ((dayInfo.get(day - run) || {}).period === 'n') run++;
  return run === 1 ? REST_SINGLE_NIGHT : REST_MULTI_NIGHT;
}

function restBreaches(dayInfo, focusDays) {
  if (dayInfo.size === 0) return new Set();
  const lo = Math.min(...focusDays) - RADIUS, hi = Math.max(...focusDays) + RADIUS;
  const days = Array.from(dayInfo.keys()).sort((a, b) => a - b);
  const out = new Set();
  for (let i = 0; i < days.length - 1; i++) {
    const a = days[i], b = days[i + 1];
    if (b < lo || a > hi) continue;
    const end = a * 24 + dayInfo.get(a).end;
    const start = b * 24 + dayInfo.get(b).start;
    if (start - end < restRequiredAfter(dayInfo, a) - EPS) out.add(a + ',' + b);
  }
  return out;
}

// takeCode is the actual roster code being picked up (so e1's special
// timing carries through correctly); role is shared by both parties
// since swaps only happen within the same role group.
function swapIsLegal(name, role, giveDay, takeDay, takeCode) {
  const base = personDayInfo(name, role);
  const focus = [giveDay, takeDay];
  const before = restBreaches(base, focus);
  const after = new Map(base);
  after.delete(giveDay);
  const decoded = decodeCode(takeCode, role);
  const times = shiftTimesFor(takeCode, role);
  after.set(takeDay, { period: decoded.period, start: times.start, end: times.end });
  const afterBreaches = restBreaches(after, focus);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function canPickUpExtraShift(name, role, day, giveCode) {
  const base = personDayInfo(name, role);
  const focus = [day];
  const before = restBreaches(base, focus);
  const after = new Map(base);
  const decoded = decodeCode(giveCode, role);
  const times = shiftTimesFor(giveCode, role);
  after.set(day, { period: decoded.period, start: times.start, end: times.end });
  const afterBreaches = restBreaches(after, focus);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function breaksNightRun(name, role, day, periodOverride) {
  const info = personDayInfo(name, role);
  const period = periodOverride !== undefined ? periodOverride : (info.get(day) || {}).period;
  if (period !== 'n') return false;
  const prevN = (info.get(day - 1) || {}).period === 'n';
  const nextN = (info.get(day + 1) || {}).period === 'n';
  return prevN && nextN;
}

// "Similar shift types in a row" score: +1 for each neighbouring day
// (before/after) that already has the same shift type being taken on.
function continuityScore(name, role, day, type) {
  const info = personDayInfo(name, role);
  let score = 0;
  if ((info.get(day - 1) || {}).period === type) score++;
  if ((info.get(day + 1) || {}).period === type) score++;
  return score;
}

// ---------------------------------------------------------------------
// Consecutive-worked-day run check (7+ in a row is declined). A day
// counts as "worked" for this check if it's a D/S/E/N shift OR a
// Wednesday teaching day ("rt"), even though teaching isn't itself a
// swappable shift.
// ---------------------------------------------------------------------
function isWorkedDay(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  if (!raw) return false;
  const decoded = decodeCode(raw, role);
  if (decoded && decoded.period) return true;
  let lower = raw.trim().toLowerCase();
  if (lower.endsWith('-t')) lower = lower.slice(0, -2);
  return lower === 'rt';
}

function buildWorkedSet(name, role) {
  const map = personShiftMap(name, role);
  const set = new Set();
  Object.keys(map).forEach(dateStr => {
    if (isWorkedDay(name, role, dateStr)) set.add(dayNum(dateStr));
  });
  return set;
}


// New night-spacing rule: after any proposed change, reject a roster where
// two Night shifts have exactly one genuinely empty roster cell between them
// (N, blank, N). This is checked against the resulting roster for each
// person affected by the proposed transaction.
function periodOnFromMap(map, role, dateStr) {
  const raw = map[dateStr];
  if (!raw) return null;
  const decoded = decodeCode(raw, role);
  return decoded ? decoded.period : null;
}

function nightGapViolationAfterChanges(name, role, removeDays, addDaysCodes) {
  const map = personShiftMap(name, role);
  removeDays.forEach(d => { delete map[dateFromDayNum(d)]; });
  addDaysCodes.forEach(({ day, code }) => { map[dateFromDayNum(day)] = code; });

  const nDays = Object.keys(map)
    .filter(dateStr => periodOnFromMap(map, role, dateStr) === 'n')
    .map(dayNum)
    .sort((a, b) => a - b);

  for (const d of nDays) {
    // N -> N still requires at least 2 genuinely empty cells between nights.
    if (nDays.includes(d + 2) && !map[dateFromDayNum(d + 1)]) return true;

    // After an N, the next occupied roster cell must leave enough genuinely
    // empty cells before a following shift: 3 before D, 2 before S or E.
    // Any occupied cell (including teaching/RT or another shift) stops this
    // particular gap check because it is not an empty cell.
    for (let gap = 1; gap <= 3; gap++) {
      const raw = map[dateFromDayNum(d + gap)];
      if (!raw) continue;

      const period = periodOnFromMap(map, role, dateFromDayNum(d + gap));
      if (period === 'd' && gap < 4) return true;
      if ((period === 's' || period === 'e') && gap < 3) return true;
      break;
    }
  }
  return false;
}


function longestRunTouching(workedSet, day) {
  if (!workedSet.has(day)) return 0;
  let start = day, end = day;
  while (workedSet.has(start - 1)) start--;
  while (workedSet.has(end + 1)) end++;
  return end - start + 1;
}

// True (OK) unless this specific change creates a fresh run of 7+
// consecutive worked days. A run that already existed regardless of
// this change is not blamed on the swap.
function swapKeepsRunsOk(name, role, removeDay, addDay) {
  if (removeDay === addDay) return true; // same-day swap: worked pattern unchanged
  const base = buildWorkedSet(name, role);
  const after = new Set(base);
  after.delete(removeDay);
  after.add(addDay);
  if (longestRunTouching(after, addDay) < 7) return true;
  const leftRun = longestRunTouching(base, addDay - 1);
  const rightRun = longestRunTouching(base, addDay + 1);
  return Math.max(leftRun, rightRun) >= 7;
}

function extraShiftKeepsRunsOk(name, role, addDay) {
  const base = buildWorkedSet(name, role);
  const after = new Set(base);
  after.add(addDay);
  if (longestRunTouching(after, addDay) < 7) return true;
  const leftRun = longestRunTouching(base, addDay - 1);
  const rightRun = longestRunTouching(base, addDay + 1);
  return Math.max(leftRun, rightRun) >= 7;
}

// Bundle versions: check taking on several extra shifts (all at once, not
// one-at-a-time) is still rest-compliant and doesn't create a 7+ day run.
function canPickUpBundle(name, role, days, codes) {
  const base = personDayInfo(name, role);
  const before = restBreaches(base, days);
  const after = new Map(base);
  days.forEach((day, i) => {
    const decoded = decodeCode(codes[i], role);
    const times = shiftTimesFor(codes[i], role);
    after.set(day, { period: decoded.period, start: times.start, end: times.end });
  });
  const afterBreaches = restBreaches(after, days);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function bundleKeepsRunsOk(name, role, days) {
  const base = buildWorkedSet(name, role);
  const after = new Set(base);
  days.forEach(d => after.add(d));
  for (const d of days) {
    if (longestRunTouching(after, d) < 7) continue;
    const leftRun = longestRunTouching(base, d - 1);
    const rightRun = longestRunTouching(base, d + 1);
    if (Math.max(leftRun, rightRun) >= 7) continue; // pre-existing, not caused by the bundle
    return false;
  }
  return true;
}

// ---------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------
function peopleOfRole(role) {
  return PEOPLE.filter(p => p.r === role).map(p => p.n).sort((a, b) => a.localeCompare(b));
}

// Minimum 2 ERIC-capable registrars covering nights, whoever's actual
// slot code they're rostered under (not tied to the n1 "ERIC" label).
// overrides lets us ask "what would coverage be if X worked Y instead".
function ericCountForDate(dateStr, overrides) {
  let count = 0;
  for (const name of peopleOfRole('R')) {
    const period = (overrides && Object.prototype.hasOwnProperty.call(overrides, name)) ? overrides[name] : periodOn(name, 'R', dateStr);
    if (period === 'n' && isEricCapable(name)) count++;
  }
  return count;
}
function ericMinimumHolds(dateStr, overrides) {
  const before = ericCountForDate(dateStr, null);
  if (before < 2) return true; // already a pre-existing gap — not this swap's fault
  return ericCountForDate(dateStr, overrides) >= 2;
}

function findSwaps(doctor, role, giveDateStr, windowDays, sameTypeOnly, acceptTypes, acceptDays, allowSameDay) {
  const giveDay = dayNum(giveDateStr);
  const giveType = periodOn(doctor, role, giveDateStr);
  if (!giveType) throw new Error('That no longer looks like a workable shift.');
  const giveCode = rawCodeOn(doctor, role, giveDateStr);
  const tomorrowStr = dateFromDayNum(dayNum(todayStr) + 1);

  const options = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    if (!isFreeOn(partner, role, giveDateStr)) {
      if (periodOn(partner, role, giveDateStr) === null) continue; // on leave / non-workable — hard stop
    }
    for (let offset = -windowDays; offset <= windowDays; offset++) {
      const takeDay = giveDay + offset;
      const takeDateStr = dateFromDayNum(takeDay);
      if (takeDateStr < tomorrowStr) continue; // only show results from tomorrow onward
      const takeType = periodOn(partner, role, takeDateStr);
      if (!takeType) continue;
      const takeCode = rawCodeOn(partner, role, takeDateStr);

      const sameDay = offset === 0;
      if (sameDay) {
        if (!allowSameDay || takeType === giveType) continue;
      } else {
        if (!isFreeOn(partner, role, giveDateStr)) continue;
        if (!isFreeOn(doctor, role, takeDateStr)) continue;
      }

      if (sameTypeOnly && takeType !== giveType) continue;
      if (acceptTypes.size > 0 && !acceptTypes.has(takeType)) continue;
      const weekdayIdx = (new Date(takeDateStr + 'T00:00:00Z').getUTCDay() + 6) % 7; // 0=Mon..6=Sun
      if (acceptDays.size > 0 && !acceptDays.has(weekdayIdx)) continue;

      if (!swapIsLegal(doctor, role, giveDay, takeDay, takeCode)) continue;
      if (!swapIsLegal(partner, role, takeDay, giveDay, giveCode)) continue;

      if (!swapKeepsRunsOk(doctor, role, giveDay, takeDay)) continue;
      if (!swapKeepsRunsOk(partner, role, takeDay, giveDay)) continue;
      if (nightGapViolationAfterChanges(doctor, role, [giveDay], [{ day: takeDay, code: takeCode }])) continue;
      if (nightGapViolationAfterChanges(partner, role, [takeDay], [{ day: giveDay, code: giveCode }])) continue;

      if (role === 'R') {
        const affectedDates = new Set();
        if (giveType === 'n') affectedDates.add(giveDateStr);
        if (takeType === 'n') affectedDates.add(takeDateStr);
        let ericOk = true;
        for (const d of affectedDates) {
          const overrides = { [doctor]: d === takeDateStr ? takeType : null, [partner]: d === giveDateStr ? giveType : null };
          if (!ericMinimumHolds(d, overrides)) { ericOk = false; break; }
        }
        if (!ericOk) continue;
      }

      const score = continuityScore(doctor, role, takeDay, takeType) + continuityScore(partner, role, giveDay, giveType);

      options.push({
        date: takeDateStr,
        shiftType: takeType,
        shiftText: textOn(partner, role, takeDateStr),
        partner,
        sameDay,
        weekend: new Date(takeDateStr + 'T00:00:00').getDay() % 6 === 0,
        breaksPartnerNightRun: breaksNightRun(partner, role, takeDay),
        continuityScore: score,
      });
    }
  }
  options.sort((a, b) => b.continuityScore - a.continuityScore || a.date.localeCompare(b.date));
  return { doctor, giveDateStr, giveType, giveText: textOn(doctor, role, giveDateStr), options, windowDays };
}

function findTakers(doctor, role, giveDateStr) {
  const giveDay = dayNum(giveDateStr);
  const giveType = periodOn(doctor, role, giveDateStr);
  if (!giveType) throw new Error('That no longer looks like a workable shift.');
  const giveCode = rawCodeOn(doctor, role, giveDateStr);

  const takers = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    if (!isFreeOn(partner, role, giveDateStr)) continue;
    if (!canPickUpExtraShift(partner, role, giveDay, giveCode)) continue;
    if (!extraShiftKeepsRunsOk(partner, role, giveDay)) continue;
    if (nightGapViolationAfterChanges(partner, role, [], [{ day: giveDay, code: giveCode }])) continue;
    if (nightGapViolationAfterChanges(doctor, role, [giveDay], [])) continue;
    if (role === 'R' && giveType === 'n') {
      const overrides = { [doctor]: null, [partner]: giveType };
      if (!ericMinimumHolds(giveDateStr, overrides)) continue;
    }
    takers.push({
      partner,
      breaksNightRun: breaksNightRun(partner, role, giveDay, giveType),
      continuityScore: continuityScore(partner, role, giveDay, giveType),
    });
  }
  takers.sort((a, b) => b.continuityScore - a.continuityScore || a.partner.localeCompare(b.partner));
  return { doctor, giveDateStr, giveType, giveText: textOn(doctor, role, giveDateStr), takers };
}

// True bundle check: could this one person take every selected shift at
// once? Verified as a single combined legality check, not shift-by-shift.
function findBundleTakers(doctor, role, giveDates) {
  const giveDays = giveDates.map(dayNum);
  const giveCodes = giveDates.map(d => rawCodeOn(doctor, role, d));
  giveDates.forEach((d, i) => {
    if (!giveCodes[i] || !decodeCode(giveCodes[i], role).period) throw new Error('One of the selected shifts is no longer workable.');
  });

  const giveTypes = giveDates.map(d => periodOn(doctor, role, d));

  const candidates = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    if (!giveDates.every(d => isFreeOn(partner, role, d))) continue;
    if (!canPickUpBundle(partner, role, giveDays, giveCodes)) continue;
    if (!bundleKeepsRunsOk(partner, role, giveDays)) continue;
    if (nightGapViolationAfterChanges(partner, role, [], giveDays.map((day, i) => ({ day, code: giveCodes[i] })))) continue;
    if (nightGapViolationAfterChanges(doctor, role, giveDays, [])) continue;
    if (role === 'R') {
      let ericOk = true;
      giveDates.forEach((d, i) => {
        if (giveTypes[i] !== 'n') return;
        const overrides = { [doctor]: null, [partner]: giveTypes[i] };
        if (!ericMinimumHolds(d, overrides)) ericOk = false;
      });
      if (!ericOk) continue;
    }
    candidates.push(partner);
  }
  candidates.sort((a, b) => a.localeCompare(b));
  return candidates;
}

// ---------------------------------------------------------------------
// True bundle swap: find a partner and a specific pairing of your N
// shifts against N of theirs such that giving/taking ALL of them at
// once, for both people simultaneously, is verified legal as one
// combined transaction (not N independent single swaps).
// ---------------------------------------------------------------------
function bundleSwapIsLegal(name, role, removeDays, addDaysCodes) {
  const base = personDayInfo(name, role);
  const focus = removeDays.concat(addDaysCodes.map(x => x.day));
  const before = restBreaches(base, focus);
  const after = new Map(base);
  removeDays.forEach(d => after.delete(d));
  addDaysCodes.forEach(({ day, code }) => {
    const decoded = decodeCode(code, role);
    const times = shiftTimesFor(code, role);
    after.set(day, { period: decoded.period, start: times.start, end: times.end });
  });
  const afterBreaches = restBreaches(after, focus);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function bundleSwapKeepsRunsOk(name, role, removeDays, addDays) {
  const rawBase = buildWorkedSet(name, role);
  const preBase = new Set(rawBase);
  removeDays.forEach(d => preBase.delete(d)); // state after giving shifts away, before taking new ones
  const after = new Set(preBase);
  addDays.forEach(d => after.add(d));
  for (const d of addDays) {
    if (longestRunTouching(after, d) < 7) continue;
    const leftRun = longestRunTouching(preBase, d - 1);
    const rightRun = longestRunTouching(preBase, d + 1);
    if (Math.max(leftRun, rightRun) >= 7) continue; // pre-existing, not caused by this bundle
    return false;
  }
  return true;
}

// Search one partner for a complete, distinct pairing of give-shifts to
// take-shifts that passes the combined legality check for both people.
function findBundleSwapForPartner(doctor, role, giveShifts, partner, opts) {
  const { windowDays, sameTypeOnly, acceptTypes, acceptDays, allowSameDay } = opts;
  const giveDateSet = new Set(giveShifts.map(g => g.date));
  const tomorrowStr = dateFromDayNum(dayNum(todayStr) + 1);

  const candidatesPerShift = giveShifts.map(g => {
    const list = [];
    for (let offset = -windowDays; offset <= windowDays; offset++) {
      const takeDay = g.dayNum + offset;
      const takeDateStr = dateFromDayNum(takeDay);
      if (takeDateStr < tomorrowStr) continue;
      if (giveDateSet.has(takeDateStr) && takeDateStr !== g.date) continue; // don't cross into another of your own give-days
      const takeType = periodOn(partner, role, takeDateStr);
      if (!takeType) continue;
      const takeCode = rawCodeOn(partner, role, takeDateStr);
      const sameDay = offset === 0;
      if (sameDay) {
        if (!allowSameDay || takeType === g.type) continue;
      } else {
        if (!isFreeOn(partner, role, g.date)) continue;
        if (!isFreeOn(doctor, role, takeDateStr)) continue;
      }
      if (sameTypeOnly && takeType !== g.type) continue;
      if (acceptTypes.size > 0 && !acceptTypes.has(takeType)) continue;
      const weekdayIdx = (new Date(takeDateStr + 'T00:00:00Z').getUTCDay() + 6) % 7;
      if (acceptDays.size > 0 && !acceptDays.has(weekdayIdx)) continue;
      list.push({ day: takeDay, dateStr: takeDateStr, type: takeType, code: takeCode });
    }
    return list;
  });
  if (candidatesPerShift.some(list => list.length === 0)) return null;

  let attempts = 0;
  const MAX_ATTEMPTS = 300;

  function verify(assignment) {
    const doctorRemove = giveShifts.map(g => g.dayNum);
    const doctorAdd = assignment.map(a => ({ day: a.take.day, code: a.take.code }));
    const partnerRemove = assignment.map(a => a.take.day);
    const partnerAdd = giveShifts.map(g => ({ day: g.dayNum, code: g.code }));
    if (!bundleSwapIsLegal(doctor, role, doctorRemove, doctorAdd)) return false;
    if (!bundleSwapIsLegal(partner, role, partnerRemove, partnerAdd)) return false;
    if (!bundleSwapKeepsRunsOk(doctor, role, doctorRemove, doctorAdd.map(x => x.day))) return false;
    if (!bundleSwapKeepsRunsOk(partner, role, partnerRemove, partnerAdd.map(x => x.day))) return false;
    if (nightGapViolationAfterChanges(doctor, role, doctorRemove, doctorAdd)) return false;
    if (nightGapViolationAfterChanges(partner, role, partnerRemove, partnerAdd)) return false;

    if (role === 'R') {
      const affectedDates = new Set();
      giveShifts.forEach(g => { if (g.type === 'n') affectedDates.add(g.date); });
      assignment.forEach(a => { if (a.take.type === 'n') affectedDates.add(a.take.dateStr); });
      for (const d of affectedDates) {
        const giveEntry = giveShifts.find(g => g.date === d);
        const takeEntry = assignment.find(a => a.take.dateStr === d);
        const overrides = {
          [doctor]: takeEntry ? takeEntry.take.type : null,
          [partner]: giveEntry ? giveEntry.type : null,
        };
        if (!ericMinimumHolds(d, overrides)) return false;
      }
    }
    return true;
  }

  function backtrack(idx, usedDays, assignment) {
    if (attempts > MAX_ATTEMPTS) return null;
    if (idx === giveShifts.length) {
      attempts++;
      return verify(assignment) ? assignment.slice() : null;
    }
    for (const cand of candidatesPerShift[idx]) {
      if (usedDays.has(cand.day)) continue;
      usedDays.add(cand.day);
      assignment.push({ give: giveShifts[idx], take: cand });
      const result = backtrack(idx + 1, usedDays, assignment);
      if (result) return result;
      assignment.pop();
      usedDays.delete(cand.day);
      if (attempts > MAX_ATTEMPTS) return null;
    }
    return null;
  }

  return backtrack(0, new Set(), []);
}

function findBundleSwapPartners(doctor, role, giveDates, opts) {
  const giveShifts = giveDates.map(d => ({
    date: d,
    dayNum: dayNum(d),
    type: periodOn(doctor, role, d),
    code: rawCodeOn(doctor, role, d),
  }));
  if (giveShifts.some(g => !g.type)) throw new Error('One of the selected shifts is no longer workable.');

  const matches = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    const assignment = findBundleSwapForPartner(doctor, role, giveShifts, partner, opts);
    if (assignment) matches.push({ partner, assignment });
  }
  return matches;
}


  }
  .day-group-label:first-child { margin-top: 0; }

  .shift-card {
    background: #fff;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    box-shadow: 0 1px 2px rgba(20,20,40,0.04);
    border: none;
    width: 100%;
    text-align: left;

<body>
<header>
  <h1>Find a Swap</h1>
  <div class="person-row">
    <select class="person-select" id="consultantSelect">
      <option value="">Choose consultant...</option>
    </select>
    <select class="person-select" id="registrarSelect">
      <option value="">Choose registrar...</option>
    </select>
  </div>
</header>

<div class="content" id="content">
  <div class="empty-state">Pick your name above to see your upcoming shifts.</div>
</div>

<div class="site-link"><a href="https://edrosters.com" target="_blank" rel="noopener">edrosters.com</a></div>

<script>
const DATA_URL = "https://edrosters.github.io/ed-roster-data/my_roster.json";
const STORAGE_KEY = 'myShifts.selectedPerson';
let PEOPLE = [];
let currentPerson = null;   // { n, r }
let selectedShift = null;   // { date }
let activeTab = 'swap';
let acceptTypeSet = new Set(); // "accept swaps of these shifts only" — empty = accept any type
const todayStr = new Date().toISOString().slice(0, 10);

// ---------------------------------------------------------------------
// Roster decoding — ported directly from myshifts.html so this page
// reads shift codes exactly the same way as the roster app does.
// ---------------------------------------------------------------------
const DAY_ROLE = {1:'EPIC',2:'Purple',3:'Green',4:'Fast Track',5:'SSU',6:'Purple',7:'Green',9:'Green'};
const EVENING_ROLE = {1:'EPIC',2:'Purple',3:'Green',4:'Fast Track',5:'SSU',6:'Green',7:'Purple',9:'Green'};
const WED_ROLE = {x:'Wednesday Purple', y:'Wednesday Fast Track', z:'Wednesday OM'};
const PERIOD_NAME = {d:'Day', s:'Swing', e:'Eve', n:'Night'};
const REG_ROLE = {
  d: {'1':'Purple','2':'Green','3':'Fast Track','4':'SSU','5':'Purple'},
  s: {'1':'Green','2':'Purple','3':'Green','4':'Green','5':'Purple','6':'Purple'},
  e: {'1':'Purple','2':'Green','3':'Fast Track','4':'Green','5':'Purple','6':'Fast Track','7':'Purple','8':'Green','9':'Purple','z':'Green','01':'Purple','02':'Green'},
  n: {'1':'ERIC','2':'Purple','3':'Green','4':'SSU','5':'Fast Track','6':'Purple'},
};
const PERIOD_COLOR = {
  d: {bg:'#FBF6D9', ink:'#A6942A'},
  s: {bg:'#EAF6F0', ink:'#1E8F63'},
  e: {bg:'#E3F2FB', ink:'#3B7EA8'},
  n: {bg:'#F7E3DC', ink:'#A4462E'},
};

function decodeCode(raw, role) {
  if (!raw) return null;
  let lower = raw.toLowerCase();
  let hasTraining = false;
  if (lower.endsWith('-t')) { hasTraining = true; lower = lower.slice(0, -2); }
  const withTraining = (result) => {
    if (result && hasTraining) result.text += ' + Teaching';
    return result;
  };
  if (lower === 'x' || lower === 'l' || lower === 'cl' || lower === 'sl' || lower === 'bl' || lower === 'el' || lower.startsWith('pl')) return null;
  if (lower === '8') return withTraining({ text: 'CST', period: null });
  if (lower === 'rt') return { text: 'Teaching', period: null };
  if (PERIOD_NAME[lower]) return withTraining({ text: PERIOD_NAME[lower], period: lower });

  let m = lower.match(/^d([xyz])$/);
  if (m) return withTraining({ text: WED_ROLE[m[1]], period: 'd' });

  m = lower.match(/^([dsen])(0?[0-9]{1,2}|z)([ac])?$/);
  if (m) {
    const period = m[1], num = m[2], suffix = m[3];
    const onCall = suffix === 'c';
    let text;
    if (role === 'C' && period === 'd' && DAY_ROLE[num]) text = 'Day - ' + DAY_ROLE[num];
    else if (role === 'C' && period === 'e' && EVENING_ROLE[num]) text = 'Eve - ' + EVENING_ROLE[num];
    else if (role === 'R' && REG_ROLE[period] && REG_ROLE[period][num]) text = PERIOD_NAME[period] + ' - ' + REG_ROLE[period][num];
    else text = PERIOD_NAME[period] + ' ' + num;
    if (onCall) text += ' (On call)';
    return withTraining({ text, period });
  }
  return { text: raw, period: null };
}

function personShiftMap(name, role) {
  const rec = PEOPLE.find(p => p.n === name && p.r === role);
  const map = {};
  if (!rec) return map;
  const dates = rec.d.split('|');
  const codes = rec.v.split('|');
  dates.forEach((d, i) => { map[d] = codes[i]; });
  return map;
}

function fmtWeekday(dateStr) { return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short' }); }
function fmtDayNum(dateStr) { return new Date(dateStr + 'T00:00:00').getDate(); }
function fmtMonAbbrev(dateStr) { return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-AU', { month: 'short' }); }
function fmtFull(dateStr) { return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' }); }
function mondayOf(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const offset = (d.getDay() + 6) % 7;
  d.setDate(d.getDate() - offset);
  return d;
}
function fmtWeekRange(mondayDate) {
  const sunday = new Date(mondayDate);
  sunday.setDate(sunday.getDate() + 6);
  const sameMonth = mondayDate.getMonth() === sunday.getMonth();
  const startStr = mondayDate.toLocaleDateString('en-AU', { day: 'numeric', month: sameMonth ? undefined : 'short' });
  const endStr = sunday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
  return startStr + ' - ' + endStr;
}
function fmtGroupLabel(dateStr) {
  const thisMonday = mondayOf(todayStr);
  const cardMonday = mondayOf(dateStr);
  const weekDiff = Math.round((cardMonday - thisMonday) / (7 * 86400000));
  if (weekDiff === 0) return 'This Week';
  if (weekDiff === 1) return 'Next Week';
  return fmtWeekRange(cardMonday);
}
function escapeHtml(s) {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

// ---------------------------------------------------------------------
// EBA rest-rule engine — same rules as ed_swap_finder.py, keyed by
// calendar day number instead of a spreadsheet row index.
// ---------------------------------------------------------------------
const SHIFT_TIMES = { d:{start:8.0,end:17.5}, s:{start:11.0,end:20.5}, e:{start:14.5,end:24.0}, n:{start:23.0,end:32.5} };
const REST_DAY_SWING_EVE = 10.0, REST_SINGLE_NIGHT = 23.0, REST_MULTI_NIGHT = 48.0, REST_WITHIN_NIGHT_RUN = 10.0;
const RADIUS = 5, EPS = 1e-9;

function dayNum(dateStr) { return Math.round(Date.parse(dateStr + 'T00:00:00Z') / 86400000); }
function dateFromDayNum(n) { return new Date(n * 86400000).toISOString().slice(0, 10); }

// Consultant evening slot e1/e1a/e1c runs 15:30–01:00 instead of the
// standard 14:30–00:00 evening window — everything else uses SHIFT_TIMES.
function shiftTimesFor(code, role) {
  if (!code) return null;
  const raw = String(code).trim();
  let lower = raw.toLowerCase();
  if (lower.endsWith('-t')) lower = lower.slice(0, -2);
  const decoded = decodeCode(raw, role);
  if (!decoded || !decoded.period) return null;
  if (decoded.period === 'e' && role === 'C' && /^e1[ac]?$/.test(lower)) return { start: 15.5, end: 25.0 };
  return SHIFT_TIMES[decoded.period];
}

function rawCodeOn(name, role, dateStr) {
  const map = personShiftMap(name, role);
  return map[dateStr] || null;
}
function periodOn(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  if (!raw) return null;
  const decoded = decodeCode(raw, role);
  return decoded ? decoded.period : null;
}
function isFreeOn(name, role, dateStr) {
  return !rawCodeOn(name, role, dateStr);
}
function textOn(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  const decoded = decodeCode(raw, role);
  return decoded ? decoded.text : raw;
}

// Map of day -> { period, start, end } for every workable D/S/E/N shift a person holds.
function personDayInfo(name, role) {
  const map = personShiftMap(name, role);
  const out = new Map();
  Object.keys(map).forEach(dateStr => {
    const raw = map[dateStr];
    if (!raw) return;
    const decoded = decodeCode(raw, role);
    if (!decoded || !decoded.period) return;
    const times = shiftTimesFor(raw, role);
    out.set(dayNum(dateStr), { period: decoded.period, start: times.start, end: times.end });
  });
  return out;
}

function restRequiredAfter(dayInfo, day) {
  const info = dayInfo.get(day);
  if (!info) return 0.0;
  if (info.period !== 'n') return REST_DAY_SWING_EVE;
  if ((dayInfo.get(day + 1) || {}).period === 'n') return REST_WITHIN_NIGHT_RUN;
  let run = 1;
  while ((dayInfo.get(day - run) || {}).period === 'n') run++;
  return run === 1 ? REST_SINGLE_NIGHT : REST_MULTI_NIGHT;
}

function restBreaches(dayInfo, focusDays) {
  if (dayInfo.size === 0) return new Set();
  const lo = Math.min(...focusDays) - RADIUS, hi = Math.max(...focusDays) + RADIUS;
  const days = Array.from(dayInfo.keys()).sort((a, b) => a - b);
  const out = new Set();
  for (let i = 0; i < days.length - 1; i++) {
    const a = days[i], b = days[i + 1];
    if (b < lo || a > hi) continue;
    const end = a * 24 + dayInfo.get(a).end;
    const start = b * 24 + dayInfo.get(b).start;
    if (start - end < restRequiredAfter(dayInfo, a) - EPS) out.add(a + ',' + b);
  }
  return out;
}

// takeCode is the actual roster code being picked up (so e1's special
// timing carries through correctly); role is shared by both parties
// since swaps only happen within the same role group.
function swapIsLegal(name, role, giveDay, takeDay, takeCode) {
  const base = personDayInfo(name, role);
  const focus = [giveDay, takeDay];
  const before = restBreaches(base, focus);
  const after = new Map(base);
  after.delete(giveDay);
  const decoded = decodeCode(takeCode, role);
  const times = shiftTimesFor(takeCode, role);
  after.set(takeDay, { period: decoded.period, start: times.start, end: times.end });
  const afterBreaches = restBreaches(after, focus);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function canPickUpExtraShift(name, role, day, giveCode) {
  const base = personDayInfo(name, role);
  const focus = [day];
  const before = restBreaches(base, focus);
  const after = new Map(base);
  const decoded = decodeCode(giveCode, role);
  const times = shiftTimesFor(giveCode, role);
  after.set(day, { period: decoded.period, start: times.start, end: times.end });
  const afterBreaches = restBreaches(after, focus);
  for (const k of afterBreaches) if (!before.has(k)) return false;
  return true;
}

function breaksNightRun(name, role, day, periodOverride) {
  const info = personDayInfo(name, role);
  const period = periodOverride !== undefined ? periodOverride : (info.get(day) || {}).period;
  if (period !== 'n') return false;
  const prevN = (info.get(day - 1) || {}).period === 'n';
  const nextN = (info.get(day + 1) || {}).period === 'n';
  return prevN && nextN;
}

// "Similar shift types in a row" score: +1 for each neighbouring day
// (before/after) that already has the same shift type being taken on.
function continuityScore(name, role, day, type) {
  const info = personDayInfo(name, role);
  let score = 0;
  if ((info.get(day - 1) || {}).period === type) score++;
  if ((info.get(day + 1) || {}).period === type) score++;
  return score;
}

// ---------------------------------------------------------------------
// Consecutive-worked-day run check (7+ in a row is declined). A day
// counts as "worked" for this check if it's a D/S/E/N shift OR a
// Wednesday teaching day ("rt"), even though teaching isn't itself a
// swappable shift.
// ---------------------------------------------------------------------
function isWorkedDay(name, role, dateStr) {
  const raw = rawCodeOn(name, role, dateStr);
  if (!raw) return false;
  const decoded = decodeCode(raw, role);
  if (decoded && decoded.period) return true;
  let lower = raw.trim().toLowerCase();
  if (lower.endsWith('-t')) lower = lower.slice(0, -2);
  return lower === 'rt';
}

function buildWorkedSet(name, role) {
  const map = personShiftMap(name, role);
  const set = new Set();
  Object.keys(map).forEach(dateStr => {
    if (isWorkedDay(name, role, dateStr)) set.add(dayNum(dateStr));
  });
  return set;
}

function longestRunTouching(workedSet, day) {
  if (!workedSet.has(day)) return 0;
  let start = day, end = day;
  while (workedSet.has(start - 1)) start--;
  while (workedSet.has(end + 1)) end++;
  return end - start + 1;
}

// True (OK) unless this specific change creates a fresh run of 7+
// consecutive worked days. A run that already existed regardless of
// this change is not blamed on the swap.
function swapKeepsRunsOk(name, role, removeDay, addDay) {
  if (removeDay === addDay) return true; // same-day swap: worked pattern unchanged
  const base = buildWorkedSet(name, role);
  const after = new Set(base);
  after.delete(removeDay);
  after.add(addDay);
  if (longestRunTouching(after, addDay) < 7) return true;
  const leftRun = longestRunTouching(base, addDay - 1);
  const rightRun = longestRunTouching(base, addDay + 1);
  return Math.max(leftRun, rightRun) >= 7;
}

function extraShiftKeepsRunsOk(name, role, addDay) {
  const base = buildWorkedSet(name, role);
  const after = new Set(base);
  after.add(addDay);
  if (longestRunTouching(after, addDay) < 7) return true;
  const leftRun = longestRunTouching(base, addDay - 1);
  const rightRun = longestRunTouching(base, addDay + 1);
  return Math.max(leftRun, rightRun) >= 7;
}

// ---------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------
function peopleOfRole(role) {
  return PEOPLE.filter(p => p.r === role).map(p => p.n).sort((a, b) => a.localeCompare(b));
}

function findSwaps(doctor, role, giveDateStr, windowDays, sameTypeOnly, acceptTypes, allowSameDay) {
  const giveDay = dayNum(giveDateStr);
  const giveType = periodOn(doctor, role, giveDateStr);
  if (!giveType) throw new Error('That no longer looks like a workable shift.');
  const giveCode = rawCodeOn(doctor, role, giveDateStr);

  const options = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    if (!isFreeOn(partner, role, giveDateStr)) {
      if (periodOn(partner, role, giveDateStr) === null) continue; // on leave / non-workable — hard stop
    }
    for (let offset = -windowDays; offset <= windowDays; offset++) {
      const takeDay = giveDay + offset;
      const takeDateStr = dateFromDayNum(takeDay);
      const takeType = periodOn(partner, role, takeDateStr);
      if (!takeType) continue;
      const takeCode = rawCodeOn(partner, role, takeDateStr);

      const sameDay = offset === 0;
      if (sameDay) {
        if (!allowSameDay || takeType === giveType) continue;
      } else {
        if (!isFreeOn(partner, role, giveDateStr)) continue;
        if (!isFreeOn(doctor, role, takeDateStr)) continue;
      }

      if (sameTypeOnly && takeType !== giveType) continue;
      if (acceptTypes.size > 0 && !acceptTypes.has(takeType)) continue;

      if (!swapIsLegal(doctor, role, giveDay, takeDay, takeCode)) continue;
      if (!swapIsLegal(partner, role, takeDay, giveDay, giveCode)) continue;

      if (!swapKeepsRunsOk(doctor, role, giveDay, takeDay)) continue;
      if (!swapKeepsRunsOk(partner, role, takeDay, giveDay)) continue;

      const score = continuityScore(doctor, role, takeDay, takeType) + continuityScore(partner, role, giveDay, giveType);

      options.push({
        date: takeDateStr,
        shiftType: takeType,
        shiftText: textOn(partner, role, takeDateStr),
        partner,
        sameDay,
        weekend: new Date(takeDateStr + 'T00:00:00').getDay() % 6 === 0,
        breaksPartnerNightRun: breaksNightRun(partner, role, takeDay),
        continuityScore: score,
      });
    }
  }
  options.sort((a, b) => b.continuityScore - a.continuityScore || a.date.localeCompare(b.date));
  return { doctor, giveDateStr, giveType, giveText: textOn(doctor, role, giveDateStr), options, windowDays };
}

function findTakers(doctor, role, giveDateStr) {
  const giveDay = dayNum(giveDateStr);
  const giveType = periodOn(doctor, role, giveDateStr);
  if (!giveType) throw new Error('That no longer looks like a workable shift.');
  const giveCode = rawCodeOn(doctor, role, giveDateStr);

  const takers = [];
  for (const partner of peopleOfRole(role)) {
    if (partner === doctor) continue;
    if (!isFreeOn(partner, role, giveDateStr)) continue;
    if (!canPickUpExtraShift(partner, role, giveDay, giveCode)) continue;
    if (!extraShiftKeepsRunsOk(partner, role, giveDay)) continue;
    takers.push({
      partner,
      breaksNightRun: breaksNightRun(partner, role, giveDay, giveType),
      continuityScore: continuityScore(partner, role, giveDay, giveType),
    });
  }
  takers.sort((a, b) => b.continuityScore - a.continuityScore || a.partner.localeCompare(b.partner));
  return { doctor, giveDateStr, giveType, giveText: textOn(doctor, role, giveDateStr), takers };
}

// ---------------------------------------------------------------------
// UI
// ---------------------------------------------------------------------
const consultantSelect = document.getElementById('consultantSelect');
const registrarSelect = document.getElementById('registrarSelect');
const content = document.getElementById('content');

function selectPerson(name, role) {
  selectedShift = null;
  currentPerson = name ? { n: name, r: role } : null;
  try {
    if (currentPerson) localStorage.setItem(STORAGE_KEY, name + '|' + role);
    else localStorage.removeItem(STORAGE_KEY);
  } catch (e) {}
  renderShiftList();
}

consultantSelect.addEventListener('change', () => {
  if (consultantSelect.value) { registrarSelect.value = ''; selectPerson(consultantSelect.value, 'C'); }
  else selectPerson('', null);
});
registrarSelect.addEventListener('change', () => {
  if (registrarSelect.value) { consultantSelect.value = ''; selectPerson(registrarSelect.value, 'R'); }
  else selectPerson('', null);
});

function renderShiftList() {
  if (!currentPerson) {
    content.innerHTML = '<div class="empty-state">Pick your name above to see your upcoming shifts.</div>';
    return;
  }
  const map = personShiftMap(currentPerson.n, currentPerson.r);
  const dates = Object.keys(map).filter(d => d >= todayStr).sort();
  let html = '';
  let lastGroup = null;
  let any = false;
  dates.forEach(d => {
    const decoded = decodeCode(map[d], currentPerson.r);
    if (!decoded || !decoded.period) return;
    any = true;
    const group = fmtGroupLabel(d);
    if (group !== lastGroup) {
      html += '<div class="day-group-label">' + escapeHtml(group) + '</div>';
      lastGroup = group;
    }
    const colors = PERIOD_COLOR[decoded.period];
    html += '<button class="shift-card" data-date="' + d + '">' +
      '<div class="date-block"><div class="dow">' + fmtWeekday(d) + '</div>' +
      '<div class="num">' + fmtDayNum(d) + '</div>' +
      '<div class="mon">' + fmtMonAbbrev(d) + '</div></div>' +
      '<div class="shift-info"><div class="shift-text" style="color:' + colors.ink + '">' + escapeHtml(decoded.text) + '</div>' +
      '<div class="shift-sub">Tap to find a swap or give it away</div></div>' +
      '<div class="chevron">&#8250;</div></button>';
  });
  content.innerHTML = any ? html : '<div class="empty-state">No upcoming shifts found for ' + escapeHtml(currentPerson.n) + '.</div>';
  content.querySelectorAll('.shift-card').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedShift = { date: btn.dataset.date };
      activeTab = 'swap';
      acceptTypeSet = new Set();
      renderDetail();
    });
  });
}

function renderDetail() {
  const d = selectedShift.date;
  const decoded = decodeCode(personShiftMap(currentPerson.n, currentPerson.r)[d], currentPerson.r);
  const colors = PERIOD_COLOR[decoded.period];

  let html = '<button class="detail-back" id="backBtn">&larr; Your shifts</button>';
  html += '<div class="summary-card"><div class="label">Looking to move</div>' +
    '<div class="main" style="color:' + colors.ink + '">' + escapeHtml(fmtFull(d)) + ' &middot; ' + escapeHtml(decoded.text) + '</div></div>';

  html += '<div class="tabs">' +
    '<button class="tab-btn' + (activeTab === 'swap' ? ' active' : '') + '" data-tab="swap">Find a swap</button>' +
    '<button class="tab-btn' + (activeTab === 'taker' ? ' active' : '') + '" data-tab="taker">Give it away</button>' +
    '</div>';

  html += '<div id="tabBody"></div>';
  content.innerHTML = html;

  document.getElementById('backBtn').addEventListener('click', () => { selectedShift = null; renderShiftList(); });
  content.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => { activeTab = btn.dataset.tab; renderDetail(); });
  });

  if (activeTab === 'swap') renderSwapTab();
  else renderTakerTab();
}

function renderSwapTab() {
  const body = document.getElementById('tabBody');
  const giveType = periodOn(currentPerson.n, currentPerson.r, selectedShift.date);
  body.innerHTML =
    '<div class="controls">' +
      '<div class="field"><label>Search window</label>' +
        '<select id="windowSelect"><option value="7">1 week either side</option><option value="14" selected>2 weeks either side</option><option value="28">4 weeks either side</option></select>' +
      '</div>' +
      '<div class="field"><label>Accept swaps of these shifts only</label>' +
        '<div class="type-toggles">' +
          '<div class="type-toggle" data-type="d">D</div><div class="type-toggle" data-type="s">S</div>' +
          '<div class="type-toggle" data-type="e">E</div><div class="type-toggle" data-type="n">N</div>' +
        '</div>' +
      '</div>' +
      '<label class="checkrow"><input type="checkbox" id="sameTypeOnly"> Only offer the same shift type back</label>' +
      '<label class="checkrow"><input type="checkbox" id="allowSameDay" checked> Allow a same-day, different-type swap</label>' +
    '</div>' +
    '<button class="search-btn" id="searchBtn">Search</button>' +
    '<div id="resultsBody"></div>';

  function refreshToggleStyles() {
    body.querySelectorAll('.type-toggle').forEach(el => el.classList.toggle('on', acceptTypeSet.has(el.dataset.type)));
  }
  refreshToggleStyles();

  body.querySelectorAll('.type-toggle').forEach(el => {
    el.addEventListener('click', () => {
      const t = el.dataset.type;
      if (acceptTypeSet.has(t)) acceptTypeSet.delete(t);
      else acceptTypeSet.add(t);
      refreshToggleStyles();
    });
  });

  document.getElementById('sameTypeOnly').addEventListener('change', (e) => {
    acceptTypeSet.clear();
    if (e.target.checked && giveType) acceptTypeSet.add(giveType);
    refreshToggleStyles();
  });

  document.getElementById('searchBtn').addEventListener('click', () => {
    const windowDays = parseInt(document.getElementById('windowSelect').value, 10);
    const sameTypeOnly = document.getElementById('sameTypeOnly').checked;
    const allowSameDay = document.getElementById('allowSameDay').checked;
    try {
      const result = findSwaps(currentPerson.n, currentPerson.r, selectedShift.date, windowDays, sameTypeOnly, acceptTypeSet, allowSameDay);
      renderSwapResults(result);
    } catch (err) {
      document.getElementById('resultsBody').innerHTML = '<div class="status-msg">' + escapeHtml(err.message) + '</div>';
    }
  });
}

function renderSwapResults(result) {
  const out = document.getElementById('resultsBody');
  if (!result.options.length) {
    out.innerHTML = '<div class="status-msg">No legal swaps found in this window. Try a wider search window or relax the shift-type restriction.</div>';
    return;
  }

  const byDate = new Map();
  result.options.forEach(o => {
    if (!byDate.has(o.date)) byDate.set(o.date, []);
    byDate.get(o.date).push(o);
  });

  const giveDay = dayNum(result.giveDateStr);
  const rangeStartStr = dateFromDayNum(giveDay - result.windowDays);
  const rangeEndStr = dateFromDayNum(giveDay + result.windowDays);
  const gridStart = mondayOf(rangeStartStr);
  const endMonday = mondayOf(rangeEndStr);
  const gridEnd = new Date(endMonday);
  gridEnd.setDate(gridEnd.getDate() + 6);

  const wdNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  let html = '<div class="cal-wrap">' +
    '<div class="cal-grid cal-headrow">' + wdNames.map(w => '<div class="cal-head-cell">' + w + '</div>').join('') + '</div>' +
    '<div class="cal-grid">';

  let cur = new Date(gridStart);
  let defaultDate = null;
  while (cur <= gridEnd) {
    const dStr = cur.toISOString().slice(0, 10);
    const inWindow = dStr >= rangeStartStr && dStr <= rangeEndStr;
    const opts = (byDate.get(dStr) || []).slice().sort((a, b) => b.continuityScore - a.continuityScore);
    if (!defaultDate && opts.length) defaultDate = dStr;
    let cls = 'cal-cell';
    if (!inWindow) cls += ' cal-outside';
    if (dStr === result.giveDateStr) cls += ' cal-give';
    if (opts.length) cls += ' has-opts';
    html += '<div class="' + cls + '" data-date="' + dStr + '"><div class="cal-daynum">' + cur.getDate() + '</div>';
    if (opts.length) {
      html += '<div class="cal-dots">' + opts.slice(0, 4).map(o => '<span class="cal-dot" style="background:' + PERIOD_COLOR[o.shiftType].ink + '"></span>').join('') + '</div>';
      if (opts.length > 4) html += '<div class="cal-more">+' + (opts.length - 4) + '</div>';
    }
    html += '</div>';
    cur.setDate(cur.getDate() + 1);
  }
  html += '</div></div>';
  html += '<div class="cal-legend">' + Object.keys(PERIOD_NAME).map(t =>
    '<span class="cal-legend-item"><span class="cal-dot" style="background:' + PERIOD_COLOR[t].ink + '"></span>' + PERIOD_NAME[t] + '</span>').join('') + '</div>';
  html += '<div id="calDetail"></div>';
  html += '<div class="actions-row"><button class="ghost-btn" id="csvBtn">Download CSV</button></div>';
  out.innerHTML = html;

  out.querySelectorAll('.cal-cell.has-opts').forEach(cell => {
    cell.addEventListener('click', () => {
      out.querySelectorAll('.cal-cell').forEach(c => c.classList.remove('selected'));
      cell.classList.add('selected');
      renderCalDetail(byDate.get(cell.dataset.date), cell.dataset.date);
    });
  });

  if (defaultDate) {
    const cell = out.querySelector('.cal-cell[data-date="' + defaultDate + '"]');
    if (cell) cell.classList.add('selected');
    renderCalDetail(byDate.get(defaultDate), defaultDate);
  }

  document.getElementById('csvBtn').addEventListener('click', () => downloadSwapCsv(result));
}

function renderCalDetail(opts, dateStr) {
  const box = document.getElementById('calDetail');
  if (!opts || !opts.length) { box.innerHTML = ''; return; }
  const sorted = opts.slice().sort((a, b) => b.continuityScore - a.continuityScore);
  let html = '<div class="day-group-label">' + escapeHtml(fmtFull(dateStr)) + '</div>';
  sorted.forEach(o => {
    const colors = PERIOD_COLOR[o.shiftType];
    html += '<div class="option-card">' +
      '<span class="type-badge" style="background:' + colors.bg + ';color:' + colors.ink + '">' + PERIOD_NAME[o.shiftType] + '</span>' +
      '<div class="option-info"><div class="option-partner">' + escapeHtml(o.partner) + '</div>' +
      '<div class="option-meta">' + escapeHtml(o.shiftText) +
      (o.sameDay ? '<span class="flag">same day</span>' : '') +
      (o.breaksPartnerNightRun ? '<span class="flag">mid night-run</span>' : '') +
      (o.continuityScore > 0 ? '<span class="flag good">good fit</span>' : '') +
      '</div></div></div>';
  });
  box.innerHTML = html;
}

function renderTakerTab() {
  const body = document.getElementById('tabBody');
  body.innerHTML = '<div id="takerBody"><div class="status-msg">Checking who could take this…</div></div>';
  try {
    const result = findTakers(currentPerson.n, currentPerson.r, selectedShift.date);
    renderTakerResults(result);
  } catch (err) {
    document.getElementById('takerBody').innerHTML = '<div class="status-msg">' + escapeHtml(err.message) + '</div>';
  }
}

function renderTakerResults(result) {
  const out = document.getElementById('takerBody');
  if (!result.takers.length) {
    out.innerHTML = '<div class="status-msg">No one is free and legally able to take this shift outright.</div>';
    return;
  }
  let html = '';
  result.takers.forEach(t => {
    html += '<div class="taker-chip"><div class="name">' + escapeHtml(t.partner) + '</div>' +
      '<div class="meta">Free that day' + (t.breaksNightRun ? ' &middot; would sit mid a night run' : '') +
      (t.continuityScore > 0 ? '<span class="flag good">good fit</span>' : '') + '</div></div>';
  });
  html += '<div class="actions-row"><button class="ghost-btn" id="csvBtn2">Download CSV</button></div>';
  out.innerHTML = html;
  document.getElementById('csvBtn2').addEventListener('click', () => downloadTakerCsv(result));
}

function csvDownload(filename, rows) {
  const csv = rows.map(r => r.map(v => {
    const s = String(v ?? '');
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function downloadSwapCsv(result) {
  const rows = [['date', 'shift_type', 'shift_text', 'partner', 'same_day', 'weekend', 'breaks_partner_night_run', 'continuity_score']];
  result.options.forEach(o => rows.push([o.date, o.shiftType, o.shiftText, o.partner, o.sameDay, o.weekend, o.breaksPartnerNightRun, o.continuityScore]));
  csvDownload('swap-options-' + result.doctor.replace(/\s+/g, '_') + '-' + result.giveDateStr + '.csv', rows);
}
function downloadTakerCsv(result) {
  const rows = [['partner', 'breaks_night_run', 'continuity_score']];
  result.takers.forEach(t => rows.push([t.partner, t.breaksNightRun, t.continuityScore]));
  csvDownload('takers-' + result.doctor.replace(/\s+/g, '_') + '-' + result.giveDateStr + '.csv', rows);
}

// ---------------------------------------------------------------------
// Load roster
// ---------------------------------------------------------------------
async function loadRoster() {
  try {
    const res = await fetch(DATA_URL, { cache: 'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    PEOPLE = await res.json();

    let prevValue = '';
    if (currentPerson) prevValue = currentPerson.n + '|' + currentPerson.r;
    else { try { prevValue = localStorage.getItem(STORAGE_KEY) || ''; } catch (e) {} }

    const consultants = PEOPLE.filter(p => p.r === 'C').sort((a, b) => a.n.localeCompare(b.n));
    const registrarsList = PEOPLE.filter(p => p.r === 'R').sort((a, b) => a.n.localeCompare(b.n));

    consultantSelect.innerHTML = '<option value="">Choose consultant...</option>' +
      consultants.map(p => '<option value="' + escapeHtml(p.n) + '">' + escapeHtml(p.n) + '</option>').join('');
    registrarSelect.innerHTML = '<option value="">Choose registrar...</option>' +
      registrarsList.map(p => '<option value="' + escapeHtml(p.n) + '">' + escapeHtml(p.n) + '</option>').join('');

    if (prevValue) {
      const [name, role] = prevValue.split('|');
      if (role === 'C' && consultants.some(p => p.n === name)) { consultantSelect.value = name; currentPerson = { n: name, r: 'C' }; }
      else if (role === 'R' && registrarsList.some(p => p.n === name)) { registrarSelect.value = name; currentPerson = { n: name, r: 'R' }; }
    }

    if (selectedShift) renderDetail(); else renderShiftList();
  } catch (err) {
    console.error('Roster load error:', err);
    content.innerHTML = '<div class="empty-state">Couldn\'t load the roster right now. Try again shortly.</div>';
  }
}

loadRoster();
setInterval(loadRoster, 5 * 60 * 1000);
</script>

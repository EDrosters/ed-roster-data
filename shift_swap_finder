  .cal-daynum { font-size: 0.7rem; font-weight: 700; color: var(--ink-soft); }
  .cal-dots { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 4px; }
  .cal-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .cal-more { font-size: 0.58rem; color: var(--ink-faint); margin-top: 1px; }
  .cal-legend { display: flex; gap: 0.7rem; flex-wrap: wrap; margin: 0.5rem 0 1rem; }
  .cal-legend-item { display: flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: var(--ink-faint); }

  .option-card { background: #fff; border-radius: 12px; padding: 0.75rem 1rem; margin-bottom: 0.5rem; box-shadow: 0 1px 2px rgba(20,20,40,0.04); display: flex; align-items: center; gap: 0.9rem; }
  .type-badge { font-size: 0.68rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 6px; display: inline-block; }
  .option-info { flex: 1; }
  .option-partner { font-weight: 700; font-size: 0.92rem; }
  .option-meta { font-size: 0.76rem; color: var(--ink-faint); margin-top: 0.1rem; }
  .flag { font-size: 0.7rem; color: #A6942A; background: #FBF6D9; padding: 0.1rem 0.4rem; border-radius: 5px; margin-left: 0.4rem; }
  .flag.good { color: #1E8F63; background: #EAF6F0; }

  .taker-chip { background: #fff; border-radius: 10px; padding: 0.7rem 0.9rem; margin-bottom: 0.5rem; box-shadow: 0 1px 2px rgba(20,20,40,0.04); }
  .taker-chip .name { font-weight: 700; font-size: 0.92rem; }
  .taker-chip .meta { font-size: 0.76rem; color: var(--ink-faint); margin-top: 0.1rem; }

  .actions-row { margin-top: 0.6rem; margin-bottom: 1.5rem; }
  .ghost-btn {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.9rem;
    font-family: inherit;

  .option-action-btn:active { background: var(--canvas); }
.option-action-btn.person-btn:hover, .option-action-btn.shift-btn:hover, .option-action-btn.bundle-person-btn:hover, .option-action-btn.bundle-shift-btn:hover { transform: none; box-shadow: 0 1px 2px rgba(80,70,110,0.04); }
.option-action-btn.person-btn:active, .option-action-btn.shift-btn:active, .option-action-btn.bundle-person-btn:active, .option-action-btn.bundle-shift-btn:active { background: #fff; }
  .option-action-btn.primary { font-weight: 700; background: #faf7ff; border-color: #d9cbed; }
  .person-btn, .shift-btn, .bundle-person-btn, .bundle-shift-btn, .cal-btn, .email-btn, .bundle-email-btn { width: 100%; }
  .person-btn { text-align: left; padding-left: 0.38rem; cursor: default; }
  .shift-btn { text-align: left; padding-left: 0.38rem; cursor: default; }

  .option-card > .type-badge { align-self: start; justify-self: start; margin-top: 0.18rem; }
  .option-preview { grid-column: 3; min-width: 0; }
  .option-preview:empty { display: none; }
  .preview-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.45rem;
    margin-top: 0;
  }
  .preview-cal-wrap { overflow-x: auto; padding-bottom: 0.3rem; }
  .preview-cal-row { display: flex; gap: 3px; margin-bottom: 3px; }
  .preview-cal-label { flex: 0 0 46px; font-size: 0.62rem; font-weight: 700; color: var(--ink-soft); display: flex; align-items: center; }
  .preview-cal-cell {
    flex: 1 1 0;
    min-width: 0;
    min-height: 42px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid var(--line);
